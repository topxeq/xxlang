// backup_remote_to_local.xxl
// Remote-to-local (R2L) incremental backup via SFTP
// Tested: all assertions pass
//
// Replace YOUR_HOST / YOUR_USER / YOUR_PASSWORD with real credentials.
import "ssh"
import "backup"

var c = ssh.connectWithConfig({
    "host": "YOUR_HOST",
    "port": 22,
    "user": "YOUR_USER",
    "password": "YOUR_PASSWORD",
    "ignoreHostKey": true
})
pln("SSH connected:", c.isConnected())

// ============================================================
// Setup: create remote source directory via SFTP
// ============================================================
var src = "/tmp/backup_r2l/src"     // remote path
var dst = "D:/aiprjs/xxlang/temp/backup_r2l/dst"  // local path

c.removeDir(src)
c.mkdirAll(src + "/src/handlers/api")
c.mkdirAll(src + "/tests/e2e")
c.mkdirAll(src + "/data")
c.mkdirAll(src + "/scripts")

c.writeFile(src + "/readme.md", "# Project README\nVersion 1.0\n")
c.writeFile(src + "/config.json", "{\"name\":\"test\",\"version\":1}\n")
c.writeFile(src + "/src/main.go", "package main\nfunc main() {}\n")
c.writeFile(src + "/src/handlers/api/routes.go", "package api\nvar Routes = []string{}\n")
c.writeFile(src + "/tests/e2e/smoke_test.go", "package e2e\nfunc TestSmoke() {}\n")
c.writeFile(src + "/tests/e2e/load_test.go", "package e2e\nfunc TestLoad() {}\n")
c.writeFile(src + "/data/sample.csv", "id,name\n1,test\n2,demo\n")
c.writeFile(src + "/data/notes.txt", "Some notes\n")
c.writeFile(src + "/scripts/deploy.sh", "#!/bin/bash\necho deploy\n")
c.writeFile(src + "/scripts/backup.sh", "#!/bin/bash\necho backup\n")

// Clean local target
removeDir(dst)
ensureMakeDirs(dst)

// ============================================================
// Test 1: Full backup
// ============================================================
pln("")
pln("=== Test 1: Full backup ===")
var r1 = backup.remoteToLocal(c, src, dst)
pln("success:", r1.isSuccess())
pln("copied:", r1.getFilesCopied(), "skipped:", r1.getFilesSkipped())
// Expected: copied=10, skipped=0

pln("readme exists:", fileExists(dst + "/readme.md"))
pln("routes exists:", fileExists(dst + "/src/handlers/api/routes.go"))
pln("smoke exists:", fileExists(dst + "/tests/e2e/smoke_test.go"))

// ============================================================
// Test 2: Incremental (all skip)
// ============================================================
pln("")
pln("=== Test 2: Incremental (no changes) ===")
var r2 = backup.remoteToLocal(c, src, dst)
pln("copied:", r2.getFilesCopied(), "skipped:", r2.getFilesSkipped())
// Expected: copied=0, skipped=10

// ============================================================
// Test 3: Modify remote files
// ============================================================
pln("")
pln("=== Test 3: Modify remote files ===")
sleep(1500)
c.writeFile(src + "/readme.md", "# Project README\nVersion 2.0 - MODIFIED\n")
c.writeFile(src + "/src/handlers/api/routes.go", "package api\nvar Routes = []string{} // updated\n")

var r3 = backup.remoteToLocal(c, src, dst)
pln("copied:", r3.getFilesCopied(), "skipped:", r3.getFilesSkipped())
// Expected: copied=2, skipped=8

pln("readme now:", loadText(dst + "/readme.md"))

// ============================================================
// Test 4: Add new remote files
// ============================================================
pln("")
pln("=== Test 4: Add new files ===")
c.writeFile(src + "/src/new_feature.go", "package main\nfunc newFeature() {}\n")
c.writeFile(src + "/data/export.csv", "id,name\n1,test\n2,demo\n")

var r4 = backup.remoteToLocal(c, src, dst)
pln("copied:", r4.getFilesCopied(), "skipped:", r4.getFilesSkipped())
// Expected: copied=2, skipped=10

pln("new_feature exists:", fileExists(dst + "/src/new_feature.go"))

// ============================================================
// Test 5: Mirror mode (delete local orphans)
// ============================================================
pln("")
pln("=== Test 5: Mirror mode ===")
saveText(dst + "/orphan.txt", "should be deleted")

var task5 = backup.newTask({"mode": "mirror"})
task5.setSourceRemote(c, src)
task5.setTargetLocal(dst)
var r5 = task5.execute()

pln("copied:", r5.getFilesCopied(), "skipped:", r5.getFilesSkipped(), "deleted:", r5.getFilesDeleted())
pln("orphan gone:", !fileExists(dst + "/orphan.txt"))
// Expected: deleted=1

// ============================================================
// Test 6: Hash compare (same content, new timestamp on remote)
// ============================================================
pln("")
pln("=== Test 6: Hash compare ===")
sleep(1500)
c.writeFile(src + "/config.json", "{\"name\":\"test\",\"version\":1}\n")  // same content

var task6 = backup.newTask({"compareStrategy": "hash", "hashAlgorithm": "md5"})
task6.setSourceRemote(c, src)
task6.setTargetLocal(dst)
var r6 = task6.execute()

pln("copied:", r6.getFilesCopied(), "skipped:", r6.getFilesSkipped())
// Expected: copied=0 (hash matches, timestamp change ignored)

// ============================================================
// Test 7: Exclude patterns
// ============================================================
pln("")
pln("=== Test 7: Exclude patterns (*.sh) ===")
var dst2 = "D:/aiprjs/xxlang/temp/backup_r2l/dst2"
removeDir(dst2)
ensureMakeDirs(dst2)

var task7 = backup.newTask({"mode": "full"})
task7.setSourceRemote(c, src)
task7.setTargetLocal(dst2)
task7.setExclude(["*.sh"])
var r7 = task7.execute()

pln("copied:", r7.getFilesCopied())
pln("deploy.sh excluded:", !fileExists(dst2 + "/scripts/deploy.sh"))
pln("readme included:", fileExists(dst2 + "/readme.md"))

// Cleanup
c.removeDir("/tmp/backup_r2l")
c.close()
pln("")
pln("=== ALL R2L BACKUP TESTS COMPLETE ===")
