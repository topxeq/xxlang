// test_toml_module.xxl - Test TOML module

// Load toml module
toml := loadModule("toml")

pln("=== Testing toml.parse ===")

tomlStr := "[server]\nhost = \"localhost\"\nport = 8080\nenabled = true"
doc := toml.parse(tomlStr)
pln("Parsed TOML document")

pln("")
pln("=== Testing get ===")

host := doc.get("server.host")
pln("server.host:", host)

port := doc.get("server.port")
pln("server.port:", port)

pln("")
pln("=== Testing has ===")

pln("has server.host:", doc.has("server.host"))
pln("has server.ssl:", doc.has("server.ssl"))

pln("")
pln("=== Testing keys ===")

keys := doc.keys()
pln("Top-level keys:", keys)

pln("")
pln("=== Testing toString ===")

tomlOut := doc.toString()
pln("toString length:", len(tomlOut))

pln("")
pln("=== Testing toml.create ===")

newDoc := toml.create()
pln("Created new TOML document")

pln("")
pln("=== Testing set ===")

newDoc.set("app.name", "MyApp")
newDoc.set("app.version", "1.0.0")
newDoc.set("server.host", "example.com")
newDoc.set("server.port", 443)

pln("Set values in new document")

pln("")
pln("=== Testing toString after set ===")

newTomlOut := newDoc.toString()
pln("New TOML output:")
pln(newTomlOut)

pln("")
pln("=== Testing toml.encode ===")

obj := {"app": "TestApp", "version": "2.0.0"}
tomlStr2 := toml.encode(obj)
pln("toml.encode result:")
pln(tomlStr2)

pln("")
pln("=== Testing remove ===")

newDoc.set("temp.key", "value")
pln("Before remove, has temp.key:", newDoc.has("temp.key"))

removed := newDoc.remove("temp.key")
pln("Remove result:", removed)
pln("After remove, has temp.key:", newDoc.has("temp.key"))

pln("")
pln("=== Testing toml.isValid ===")

validTOML := "[section]\nkey = \"value\""
pln("Valid TOML check:", toml.isValid(validTOML))

pln("")
pln("=== Testing save ===")

err := newDoc.save("test_output.toml")
pln("Save result:", err)

pln("")
pln("=== All TOML module tests completed ===")
