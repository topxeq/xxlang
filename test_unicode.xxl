// test_unicode.xxl - Test Unicode functions from locale module

import { toPinYin, kanaToRomaji, kanjiToKana, kanjiToRomaji } from "locale"

// Test toPinYin
pln("=== Testing toPinYin ===")
pln("toPinYin('你好'):", toPinYin("你好"))
pln("toPinYin('北京2024'):", toPinYin("北京2024"))
pln("toPinYin('中国China'):", toPinYin("中国China"))
pln("toPinYin('今天天气很好'):", toPinYin("今天天气很好"))

pln("")

// Test kanaToRomaji
pln("=== Testing kanaToRomaji ===")
pln("kanaToRomaji('こんにちは'):", kanaToRomaji("こんにちは"))
pln("kanaToRomaji('ありがとう'):", kanaToRomaji("ありがとう"))
pln("kanaToRomaji('さくら'):", kanaToRomaji("さくら"))
pln("kanaToRomaji('コンニチハ'):", kanaToRomaji("コンニチハ"))

pln("")

// Test kanjiToKana
pln("=== Testing kanjiToKana ===")
pln("kanjiToKana('一二三'):", kanjiToKana("一二三"))
pln("kanjiToKana('日本'):", kanjiToKana("日本"))
pln("kanjiToKana('東京'):", kanjiToKana("東京"))
pln("kanjiToKana('大阪'):", kanjiToKana("大阪"))

pln("")

// Test kanjiToRomaji
pln("=== Testing kanjiToRomaji ===")
pln("kanjiToRomaji('日本'):", kanjiToRomaji("日本"))
pln("kanjiToRomaji('東京'):", kanjiToRomaji("東京"))
pln("kanjiToRomaji('大阪'):", kanjiToRomaji("大阪"))

pln("")
pln("=== All tests completed ===")
