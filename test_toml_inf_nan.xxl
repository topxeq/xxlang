// test_toml_inf_nan.xxl - Test inf/nan

toml := loadModule("toml")

pln("Testing inf/nan:")

test1 := "a = inf"
doc1 := toml.parse(test1)
pln("Parse inf result:", doc1)
pln("Type:", typeOf(doc1))

test2 := "a = -inf"
doc2 := toml.parse(test2)
pln("Parse -inf result:", doc2)

test3 := "a = nan"
doc3 := toml.parse(test3)
pln("Parse nan result:", doc3)
