// test_mail.xxl - Test Email sending via mail module

mail := loadModule("mail")

pln("=== Testing mail.newClient ===")

// Create a mail client configuration
client := mail.newClient("smtp.example.com", 587, "user@example.com", "password", "-tls")
pln("Created mail client:", client)

pln("")
pln("=== Testing mail.send (Map syntax) ===")

// Note: This example shows the syntax but won't actually send without real credentials
// To actually send email, replace with real SMTP server details

mailConfig := {
    "host": "smtp.example.com",
    "port": 587,
    "user": "sender@example.com",
    "password": "your_password",
    "from": "sender@example.com",
    "fromName": "Sender Name",
    "to": "recipient@example.com",
    "subject": "Test Email from Xxlang",
    "body": "<h1>Hello from Xxlang!</h1><p>This is a test email.</p>",
    "tls": true
}

pln("Mail configuration prepared")
pln("  Host:", mailConfig["host"])
pln("  Port:", mailConfig["port"])
pln("  User:", mailConfig["user"])
pln("  To:", mailConfig["to"])
pln("  Subject:", mailConfig["subject"])

// Uncomment to actually send (requires real SMTP credentials):
// result := mail.send(mailConfig)
// if isError(result) {
//     pln("Send failed:", result)
// } else {
//     pln("Email sent successfully!")
// }

pln("")
