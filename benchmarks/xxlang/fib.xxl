// benchmarks/xxlang/fib.xxl
// Fibonacci benchmark for xxlang

func fib(n) {
    if (n <= 1) {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

// Test different sizes
pln("fib(10) = " + fib(10).toStr())
pln("fib(20) = " + fib(20).toStr())
pln("fib(30) = " + fib(30).toStr())
pln("fib(35) = " + fib(35).toStr())
