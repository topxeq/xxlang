// Test 013: Maps
// Tests map literals, operations, and methods

pln("Map literals:")
var m1 = {"name": "Alice", "age": 30}
pln(m1)

var m2 = {"a": 1, "b": 2, "c": 3}
pln(m2)

pln("Map access:")
pln(m1["name"])
pln(m1["age"])

pln("Map modification:")
m1["age"] = 31
pln(m1["age"])

m1["city"] = "NYC"
pln(m1["city"])

pln("Map with different value types:")
var mixed = {
    "int": 42,
    "float": 3.14,
    "string": "hello",
    "bool": true,
    "null": null,
    "array": [1, 2, 3]
}
pln(mixed["int"])
pln(mixed["float"])
pln(mixed["string"])
pln(mixed["bool"])
pln(mixed["null"])
pln(mixed["array"])

pln("Map functions:")
pln(len(m1))
pln(keys(m1))
pln(values(m1))

pln("hasKey function:")
pln(hasKey(m1, "name"))
pln(hasKey(m1, "unknown"))

pln("delete function:")
var m3 = {"a": 1, "b": 2, "c": 3}
delete(m3, "b")
pln(m3)

pln("merge function:")
var m4 = {"a": 1, "b": 2}
var m5 = {"c": 3, "d": 4}
pln(merge(m4, m5))

pln("entries function:")
pln(entries({"x": 1, "y": 2}))

pln("Empty map:")
var emptyMap = {}
pln(len(emptyMap))
pln(isEmpty(emptyMap))

pln("Map with integer keys:")
var numKeys = {1: "one", 2: "two", 3: "three"}
pln(numKeys[1])
pln(numKeys[2])
