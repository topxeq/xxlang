// allSharpV.xxl - Display all data types and main objects with various format verbs
// This file tests the %v, %+v, %#v output formats for Xxlang data types

pln("============================================================")
pln("Xxlang Data Types - %#v Format Output")
pln("============================================================")
pln("")

// ============================================================
// Basic Types
// ============================================================
pln("--- Basic Types ---")

var intVal = 42
var floatVal = 3.14159
var stringVal = "hello world"
var boolVal = true
var nullVal = null

pl("Int:       %%#v = %#v\n", intVal)
pl("Float:     %%#v = %#v\n", floatVal)
pl("String:    %%#v = %#v\n", stringVal)
pl("Bool:      %%#v = %#v\n", boolVal)
pl("Null:      %%#v = %#v\n", nullVal)

pln("")

// ============================================================
// Container Types
// ============================================================
pln("--- Container Types ---")

var arrayVal = [1, 2, 3, "four", 5.0]
var mapVal = {"name": "Alice", "age": 30, "active": true}

pl("Array:     %%#v = %#v\n", arrayVal)
pl("Map:       %%#v = %#v\n", mapVal)

// Empty containers
var emptyArr = []
var emptyMap = {}
pl("Empty Arr: %%#v = %#v\n", emptyArr)
pl("Empty Map: %%#v = %#v\n", emptyMap)

pln("")

// ============================================================
// Bytes and Chars
// ============================================================
pln("--- Bytes and Chars ---")

var bytesVal = bytes("hello\x00world")
var bytesFromInts = bytes(72, 101, 108, 108, 111)
var charsVal = chars("中文测试")
var charsFromCode = chars(65, 66, 67, 20013)

pl("Bytes from string:   %%#v = %#v\n", bytesVal)
pl("Bytes from ints:     %%#v = %#v\n", bytesFromInts)
pl("Chars from string:   %%#v = %#v\n", charsVal)
pl("Chars from code pts: %%#v = %#v\n", charsFromCode)

// Show all format verbs for Bytes
pln("")
pln("Bytes format verbs:")
pl("  %%v  = %v\n", bytesVal)
pl("  %%+v = %+v\n", bytesVal)
pl("  %%#v = %#v\n", bytesVal)
pl("  %%x  = %x\n", bytesVal)
pl("  %%X  = %X\n", bytesVal)
pl("  %%q  = %q\n", bytesVal)

// Show all format verbs for Chars
pln("")
pln("Chars format verbs:")
pl("  %%v  = %v\n", charsVal)
pl("  %%+v = %+v\n", charsVal)
pl("  %%#v = %#v\n", charsVal)
pl("  %%q  = %q\n", charsVal)

pln("")

// ============================================================
// BigInt and BigFloat
// ============================================================
pln("--- BigInt and BigFloat ---")

var bigIntVal = bigInt("123456789012345678901234567890")
var bigFloatVal = bigFloat("3.141592653589793238462643383279")

pl("BigInt:    %%#v = %#v\n", bigIntVal)
pl("BigFloat:  %%#v = %#v\n", bigFloatVal)

pln("")

// ============================================================
// Functions
// ============================================================
pln("--- Functions ---")

func addFunc(a, b) {
    return a + b
}

var lambdaVal = func(x) { return x * 2 }

pl("Named Func:  %%#v = %#v\n", addFunc)
pl("Lambda:      %%#v = %#v\n", lambdaVal)

pln("")

// ============================================================
// Classes and Instances
// ============================================================
pln("--- Classes and Instances ---")

class Point {
    func init(x, y) {
        this.x = x
        this.y = y
    }

    func toString() {
        return format("Point(%v, %v)", this.x, this.y)
    }
}

class Point3D : Point {
    func init(x, y, z) {
        super.init(x, y)
        this.z = z
    }
}

var pt = new Point(10, 20)
var pt3d = new Point3D(1, 2, 3)

pl("Class:     %%#v = %#v\n", Point)
pl("Instance:  %%#v = %#v\n", pt)
pl("Subclass:  %%#v = %#v\n", Point3D)
pl("Sub Inst:  %%#v = %#v\n", pt3d)

pln("")

// ============================================================
// Concurrency Types
// ============================================================
pln("--- Concurrency Types ---")

var tubeVal = makeTube(10)
var mutexVal = newMutex()
var rwMutexVal = newRWMutex()
var wgVal = newWaitGroup()
var atomicVal = newAtomic(100)
var onceVal = newOnce()

pl("Tube:      %%#v = %#v\n", tubeVal)
pl("Mutex:     %%#v = %#v\n", mutexVal)
pl("RWMutex:   %%#v = %#v\n", rwMutexVal)
pl("WaitGroup: %%#v = %#v\n", wgVal)
pl("Atomic:    %%#v = %#v\n", atomicVal)
pl("Once:      %%#v = %#v\n", onceVal)

// Context
var ctxVal = newContext()
var ctxTimeout = contextWithTimeout(ctxVal, 60)

pl("Context:   %%#v = %#v\n", ctxVal)
pl("Ctx w/ TO: %%#v = %#v\n", ctxTimeout)

pln("")

// ============================================================
// Error Type
// ============================================================
pln("--- Error Type ---")

var errVal = error("something went wrong")

pl("Error:     %%#v = %#v\n", errVal)

pln("")

// ============================================================
// StringBuilder
// ============================================================
pln("--- StringBuilder ---")

import "stringbuilder"

var sbVal = stringbuilder.create()
sbVal.write("Hello")
sbVal.write(" ")
sbVal.write("World")

pl("StringBuilder: %%#v = %#v\n", sbVal)

pln("")

// ============================================================
// Time Type
// ============================================================
pln("--- Time Type ---")

var timeVal = now()

pl("Time:      %%#v = %#v\n", timeVal)

pln("")

// ============================================================
// Builtin Function
// ============================================================
pln("--- Builtin Function ---")

pl("len builtin:  %%#v = %#v\n", len)
pl("pln builtin:  %%#v = %#v\n", pln)

pln("")

// ============================================================
// Module
// ============================================================
pln("--- Module ---")

import "json"
import "math"

pl("json module:  %%#v = %#v\n", json)
pl("math module:  %%#v = %#v\n", math)

pln("")

// ============================================================
// Closure with captured variables
// ============================================================
pln("--- Closure ---")

func makeCounter() {
    var count = 0
    func() {
        count = count + 1
        return count
    }
}

var counter = makeCounter()
counter()  // 1
counter()  // 2
counter()  // 3

pl("Closure:   %%#v = %#v\n", counter)

pln("")

// ============================================================
// Nested Structures
// ============================================================
pln("--- Nested Structures ---")

var nestedVal = {
    "user": {
        "name": "Bob",
        "age": 25,
        "tags": ["admin", "user"],
        "profile": {
            "email": "bob@example.com",
            "verified": true
        }
    },
    "count": 42
}

pl("Nested Map: %%#v = %#v\n", nestedVal)

pln("")

// ============================================================
// Special Characters in Strings
// ============================================================
pln("--- Special Characters ---")

var specialStr = "line1\nline2\ttab\x00null"
var specialBytes = bytes(specialStr)

pl("Special String: %%#v = %#v\n", specialStr)
pl("Special Bytes:  %%#v = %#v\n", specialBytes)

pln("")

// ============================================================
// Unicode Handling
// ============================================================
pln("--- Unicode ---")

var unicodeStr = "你好世界 🌍 emoji"
var unicodeChars = chars(unicodeStr)

pl("Unicode String: %%#v = %#v\n", unicodeStr)
pl("Unicode Chars:  %%#v = %#v\n", unicodeChars)
pl("Chars len: %v, String byte len: %v\n", len(unicodeChars), len(unicodeStr))

pln("")
pln("============================================================")
pln("End of Data Types Display")
pln("============================================================")