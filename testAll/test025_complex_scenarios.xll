// Test 025: Complex Scenarios
// Tests combining multiple features

pln("FizzBuzz:")
for (var i = 1; i <= 15; i = i + 1) {
    if (i % 15 == 0) {
        pln("FizzBuzz")
    } else if (i % 3 == 0) {
        pln("Fizz")
    } else if (i % 5 == 0) {
        pln("Buzz")
    } else {
        pln(i)
    }
}

pln("Prime checker:")
func isPrime(n) {
    if (n < 2) {
        return false
    }
    if (n == 2) {
        return true
    }
    if (n % 2 == 0) {
        return false
    }
    for (var i = 3; i * i <= n; i = i + 2) {
        if (n % i == 0) {
            return false
        }
    }
    return true
}

var primes = []
for (var n = 2; n <= 30; n = n + 1) {
    if (isPrime(n)) {
        primes = push(primes, n)
    }
}
pln(primes)

pln("Binary search:")
func binarySearch(arr, target) {
    var left = 0
    var right = len(arr) - 1

    while (left <= right) {
        var mid = (left + right) / 2
        if (arr[mid] == target) {
            return mid
        }
        if (arr[mid] < target) {
            left = mid + 1
        } else {
            right = mid - 1
        }
    }
    return -1
}

var sortedArr = [1, 3, 5, 7, 9, 11, 13, 15]
pln(binarySearch(sortedArr, 7))
pln(binarySearch(sortedArr, 8))
pln(binarySearch(sortedArr, 1))
pln(binarySearch(sortedArr, 15))

pln("Palindrome checker:")
func isPalindrome(s) {
    var chars = split(s, "")
    var reversed = reverse(chars)
    return s == join(reversed, "")
}

pln(isPalindrome("radar"))
pln(isPalindrome("hello"))
pln(isPalindrome("a"))
pln(isPalindrome(""))
