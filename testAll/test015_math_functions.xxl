// Test 015: Math Functions
// Tests mathematical built-in functions and math module

import { round, random } from "math"

pln("abs function:")
pln(abs(-5))
pln(abs(5))
pln(abs(-3.14))

pln("floor and ceil:")
pln(floor(3.7))
pln(floor(-3.7))
pln(ceil(3.2))
pln(ceil(-3.2))

pln("round function:")
pln(round(3.4))
pln(round(3.6))
pln(round(3.14159, 2))

pln("sqrt function:")
pln(sqrt(16))
pln(sqrt(2))

pln("pow function:")
pln(pow(2, 10))
pln(pow(3, 3))
pln(pow(2.5, 2))

pln("min and max:")
pln(min(3, 7))
pln(min(7, 3))
pln(max(3, 7))
pln(max(7, 3))
pln(min(-5, -3))

pln("clamp function:")
pln(clamp(5, 0, 10))
pln(clamp(-5, 0, 10))
pln(clamp(15, 0, 10))

pln("sign function:")
pln(sign(10))
pln(sign(-10))
pln(sign(0))

pln("random functions (sample checks):")
var r = random()
pln(r >= 0 && r <= 1)
var ri = randomInt(1, 10)
pln(ri >= 1 && ri <= 10)
