// ============================================================
// Full Charlang example translated to Xxlang
// Note: Key syntax differences from Charlang:
// 1. for-in: for (i, v in arr) - needs parentheses
// 2. C-style for: for (var i = 0; ...) - use 'var' not ':='
// 3. catch: catch (e) - needs parentheses
// ============================================================

// declare an array
a := [1, 2, 3, "abc", 12.3]

pln("a:", a)

pln("a[2]:", a[2])

pln("length of a:", len(a))

// reassign the array variable
a = [1, 2]

// append values
a = append(a, "abc")

b := ["xyz", 16]

// append the items in another array
a = appendArray(a, b)

a = append(a, [true, bytes(30, 31)])

plt(a)

a[0]++

a[1] = [3.2, 16]

// handle exceptions
try {
    a[6] = "5th"  // will index out of range
} catch (e) {
    pl("exception: %v", e)
}

a[4] = 1000

// the last item
a[len(a) - 1] = "last"

plt(a)

pl("a[1][1] = %v", a[1][1])

b1 := [19, 19]

pl("a + b = %v", appendArray(a, b1))

// appendList, appendArray, appendSlice are same
c := appendArray(appendArray([a], [b]), b)

plt(c)

// slice
d := a[3:5]

plt(d)

// slice with negative index
d1 := a[3:-1]

pl("d1: %v", d1)

// remove items
e := removeItems(a, 1, 3)

plt(e)

f := make("array", 2, 5)

plt(f)

f[0] = make("array", 2, 2)
f[0][0] = false
f[0][1] = true

plt(f)

g := [1.2, 3, 56]

plt(g)

// if array contains some items
pln(arrayContains(g, 56))
pln(arrayContains(g, "abc"))

// iterate
for (i, v in c) {
    pl("i: %v, v: %v", i, v)
}

// C-style for loop - Note: use 'var' not ':='
for (var i = 0; i < len(c); i = i + 1) {
    pl("i: %v, v: %v", i, c[i])
}

// ============================================================
// sorting
// ============================================================

h := [3, 17, 2, 5, 0.6, 22.8]

plt(h)

h1 := sort(h)

plt(h, h1)

var c1 = null
try {
    c1 = sort(c)
} catch (e) {
    pl("exception while sorting: %v", e)
}

plt(c, c1)

// ============================================================
// sort by function
// ============================================================

ary1 := [123, 2, "abc", "132", 3.5, "", false, true, [5, 6]]

pl("ary1: %v", ary1)

func0 := func (idx1, idx2) {
    return toStr(ary1[idx1]) < toStr(ary1[idx2])
}

ary2 := ary1.sortByFunc(func0)

// ary2 is the same as ary1, and is sorted
plt(ary1, ary2)

// ============================================================
// sort by function with closure capturing outer variable
// ============================================================

// Note: Charlang uses ex := import("ex") for extra functions
// In Xxlang we can use closures to capture the array

func1 := func (idx1, idx2) {
    return toStr(c[idx1]) < toStr(c[idx2])
}

c2 := c.sortByFunc(func1)

plt(c, c2)

// ============================================================
// String sorting with empty string handling
// ============================================================

m := ["abc", "", "123", "qwer", "fghj"]

plt(m)

m1 := sort(m)

plt(m, m1)

// use custom sort method (empty string is the largest)
func2 := func (idx1, idx2) {
    if (m[idx1] == "") {
        return false
    }

    if (m[idx2] == "") {
        return true
    }

    return toStr(m[idx1]) < toStr(m[idx2])
}

n := ["abc", "", "123", "qwer", "fghj"]

plt(n)

n.sortByFunc(func2)

plt(n)

item9 := n[-2]

plt(item9)

// ============================================================
// delegate - dynamic function from source code
// Note: Xxlang uses vargs (variadic parameter) instead of 'param ...vargs'
// ============================================================

// The delegate wraps code in func(...vargs) { ... }
// So inside the code, 'vargs' is the array of arguments
sourceT := `
    str1 := string(vargs[0])
    str2 := string(vargs[1])

    try {
        if (str1 == "abc") {
            return false
        } else if (str2 == "abc") {
            return true
        }

        rs := str1 < str2

        return rs
    } catch (e) {
        pln("exception:", e)
        return false
    }

    return false
`

dele1 := delegate(sourceT)

// Note: Xxlang delegate doesn't need .compile(), it's already compiled

n.sortByFunc(dele1)

pln(n)

pln("\n=== All tests completed ===")
