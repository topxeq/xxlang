// Test 001: Basic Types
// Tests integer, float, string, boolean, and null literals

// Integer literals
var int1 = 42
var int2 = -17
var int3 = 0

pln("Integer tests:")
pln(int1)
pln(int2)
pln(int3)

// Float literals
var float1 = 3.14
var float2 = -2.5
var float3 = 0.0

pln("Float tests:")
pln(float1)
pln(float2)
pln(float3)

// String literals
var str1 = "hello"
var str2 = ""
var str3 = "world with spaces"

pln("String tests:")
pln(str1)
pln(str2)
pln(str3)

// Boolean literals
var bool1 = true
var bool2 = false

pln("Boolean tests:")
pln(bool1)
pln(bool2)

// Null literal
var nullVal = null

pln("Null test:")
pln(nullVal)

// Type checking
pln("Type tests:")
pln(typeOf(int1))
pln(typeOf(float1))
pln(typeOf(str1))
pln(typeOf(bool1))
pln(typeOf(nullVal))
