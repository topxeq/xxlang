// Test 022: Output Functions
// Tests pr, pln, prf, pl functions

pln("pr function:")
pr("Hello")
pr(" ")
pr("World")
pln("")

pln("pln function:")
pln("Line 1")
pln("Line 2")
pln("Line 3")

pln("prf function:")
prf("Name: %s, Age: %d\n", "Alice", 30)
prf("Pi: %.2f\n", 3.14159)
prf("Hex: %x\n", 255)

pln("pl function:")
pl("%s has %d apples", "Bob", 5)
pl("The result is %d", 42)
pl("Float: %.3f", 1.23456)

pln("Multiple arguments:")
pln("arg1", "arg2", "arg3")
pln(1, 2, 3)
pln("mixed:", 42, true, null)

pln("format function (returns string):")
var formatted = format("Hello, %s!", "World")
pln(formatted)
pln(format("Count: %d, Name: %s", 10, "test"))

pln("String concatenation in output:")
var name = "Charlie"
var age = 25
pln("Name: " + name + ", Age: " + toStr(age))
