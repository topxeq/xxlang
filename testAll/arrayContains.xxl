// arrayContains.xxl - Test arrayContains function
// Ported from charlang/cmd/scripts/arrayContains.char

ary1 := ["abc", 123, 2.58]

// plv outputs using %#v format
plv(arrayContains(ary1, "abc"))

plv(arrayContains(ary1, "abcd"))

plv(arrayContains(ary1, 123))

plv(arrayContains(ary1, 1234))

plv(arrayContains(ary1, 2.58))

plv(arrayContains(ary1, 2.589))

// argsG is a built-in global variable containing command line arguments
plv(arrayContains(argsG, "-verbose"))

plv(arrayContains(argsG, 123))