// testAll.xll - Main test runner script
// Runs all test scripts and compares output with expected results

import { exists, readFile, exit, cwd } from "io"
import { shell } from "os"

// Helper function to normalize output (remove trailing whitespace, normalize line endings)
func normalizeOutput(s) {
    // Remove trailing carriage returns and spaces from each line
    // This handles platform differences
    var lines = split(s, "\n")
    var result = ""
    for (var i = 0; i < len(lines); i = i + 1) {
        var line = lines[i]
        // Trim trailing \r if present
        line = trimRight(line, "\r")
        result = result + line
        if (i < len(lines) - 1) {
            result = result + "\n"
        }
    }
    return result
}

// Get list of test files
var testFiles = [
    "test001_basic_types",
    "test002_arithmetic",
    "test003_comparison",
    "test004_logical",
    "test005_variables",
    "test006_if_else",
    "test007_while_loop",
    "test008_for_loop",
    "test009_functions",
    "test010_closures",
    "test011_arrays",
    "test012_array_functions",
    "test013_maps",
    "test014_string_functions",
    "test015_math_functions",
    "test016_type_functions",
    "test017_encoding_hash",
    "test018_classes",
    "test019_switch",
    "test020_try_catch",
    "test021_time_uuid",
    "test022_output",
    "test023_object_methods",
    "test024_iteration",
    "test025_complex_scenarios",
    "test026_prefix_infix",
    "test027_edge_cases",
    "test028_index_assignment",
    "test029_higher_order",
    "test030_recursion",
    "test031_dot_expression",
    "test032_builtin_coverage",
    "test033_charlang_compat",
    "anonymousFunc",
    "tx_anonymousFunc",
    "tx_array",
    "test034_dynamic_code"
]

var totalTests = len(testFiles)
var passedTests = 0
var failedTests = 0
var failedList = []

// Get the xxl executable path (use absolute path)
// Script is in testAll directory, xxl.exe is in parent directory
var currentDir = cwd()
var xxlPath = currentDir + "/../xxl.exe"

pln("========================================")
pln("Xxlang Comprehensive Test Suite")
pln("========================================")
pln("xxl path: " + xxlPath)
pln("")

// Run each test
for (var i = 0; i < totalTests; i = i + 1) {
    var testName = testFiles[i]
    var scriptFile = testName + ".xxl"
    var expectedFile = testName + ".txt"

    pln("Running: " + testName)

    // Check if files exist
    if (!exists(scriptFile)) {
        pln("  ERROR: Script file not found: " + scriptFile)
        failedTests = failedTests + 1
        failedList = push(failedList, testName + " (script missing)")
        continue
    }

    if (!exists(expectedFile)) {
        pln("  ERROR: Expected output file not found: " + expectedFile)
        failedTests = failedTests + 1
        failedList = push(failedList, testName + " (expected output missing)")
        continue
    }

    // Run the test using shell and capture output
    var result = shell(xxlPath + " run " + scriptFile)

    // Check if execution succeeded
    var exitCode = result[1]
    var actualOutput = result[0]

    if (exitCode != 0) {
        pln("  ERROR: Script execution failed with exit code " + toStr(exitCode))
        pln("  " + result[2])
        failedTests = failedTests + 1
        failedList = push(failedList, testName + " (execution error)")
        continue
    }

    // Read expected output
    var expectedOutput = readFile(expectedFile)

    // Normalize line endings for comparison (replace \r\n with \n)
    var normalizedActual = normalizeOutput(actualOutput)
    var normalizedExpected = normalizeOutput(expectedOutput)

    // Compare outputs
    if (normalizedActual == normalizedExpected) {
        pln("  PASSED")
        passedTests = passedTests + 1
    } else {
        pln("  FAILED")
        pln("  --- Expected ---")
        pln(normalizedExpected)
        pln("  --- Actual ---")
        pln(normalizedActual)
        pln("  ---")
        failedTests = failedTests + 1
        failedList = push(failedList, testName)

        // Stop on first failure as per requirements
        pln("")
        pln("========================================")
        pln("TEST RUN STOPPED - Failure detected")
        pln("========================================")
        pln("Failed test: " + testName)
        pln("")
        pln("Summary:")
        pln("  Total: " + toStr(i + 1))
        pln("  Passed: " + toStr(passedTests))
        pln("  Failed: " + toStr(failedTests))
        pln("")
        pln("Please fix the failing test before continuing.")
        exit(1)
    }
}

// Print summary
pln("")
pln("========================================")
pln("TEST RUN COMPLETE")
pln("========================================")
pln("")
pln("Summary:")
pln("  Total tests: " + toStr(totalTests))
pln("  Passed: " + toStr(passedTests))
pln("  Failed: " + toStr(failedTests))
pln("")

if (failedTests == 0) {
    pln("All tests passed!")
    pln("")
    pln("Coverage areas tested:")
    pln("  - Basic types (int, float, string, bool, null)")
    pln("  - Arithmetic operations")
    pln("  - Comparison operations")
    pln("  - Logical operations")
    pln("  - Variables and constants")
    pln("  - Control flow (if-else, while, for)")
    pln("  - Functions and closures")
    pln("  - Arrays and array functions")
    pln("  - Maps and map functions")
    pln("  - String functions")
    pln("  - Math functions")
    pln("  - Type checking and conversion")
    pln("  - Encoding and hash functions")
    pln("  - Classes and OOP")
    pln("  - Switch statements")
    pln("  - Try-catch-finally")
    pln("  - Time and UUID functions")
    pln("  - Output functions")
    pln("  - Object methods")
    pln("  - Iteration patterns")
    pln("  - Complex scenarios")
    pln("  - Prefix and infix operators")
    pln("  - Edge cases")
    pln("  - Assignment expressions")
    pln("  - Higher-order functions")
    pln("  - Recursion")
    pln("  - Dot expressions")
    pln("  - Command line utilities
  - Dynamic code execution")
    exit(0)
} else {
    pln("Some tests failed. Please review the failures above.")
    exit(1)
}
