// Test addBom: Bytes functions and BOM operations
// Tests bytes(), hexDecode(), concatBytes() functions

pln("bytes() function:")
var bomBytes = bytes(239, 187, 191)
pln(typeOf(bomBytes))
pln(len(bomBytes))

pln("hexDecode() function:")
var hexDecoded = hexDecode("48656C6C6F")
pln(typeOf(hexDecoded))
pln(len(hexDecoded))

pln("concatBytes() function:")
var combined = concatBytes(bomBytes, hexDecoded)
pln(typeOf(combined))
pln(len(combined))

pln("BOM verification:")
var bom = bytes(239, 187, 191)
pln("BOM length: " + len(bom))

pln("Concat with BOM:")
var textBytes = bytes(116, 101, 115, 116)
var withBom = concatBytes(bom, textBytes)
pln("Total length: " + len(withBom))

pln("Bytes operations complete.")