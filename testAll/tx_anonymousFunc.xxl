// define a complex anonymous function
func(x) {
	return func(y) {
		x(y)
	}
}(func(z) {
		pln("Hi!", z)
	})("Nice to see you.")

// anonymous function to test variable "count"
NewAddFunc := func() {
	count := 0

	return func(n) {
		count += n

		return count
	}
}

// access count through closure, can see count changing
f2 := NewAddFunc()

pln(f2(3))
	
pln(f2(5))

pln(f2(9))


