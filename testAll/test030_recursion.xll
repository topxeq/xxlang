// Test 030: Recursion
// Tests various recursive algorithms

pln("Simple recursion:")
func countdown(n) {
    if (n <= 0) {
        pln("Done!")
        return
    }
    pln(n)
    countdown(n - 1)
}
countdown(5)

pln("Factorial (recursive):")
func factorial(n) {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}
pln(factorial(1))
pln(factorial(5))
pln(factorial(10))

pln("Fibonacci (recursive):")
func fib(n) {
    if (n <= 1) {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

pln(fib(0))
pln(fib(1))
pln(fib(10))
pln(fib(15))

pln("GCD (recursive):")
func gcd(a, b) {
    if (b == 0) {
        return a
    }
    return gcd(b, a % b)
}
pln(gcd(48, 18))
pln(gcd(100, 35))
pln(gcd(17, 13))

pln("Sum of digits:")
func sumDigits(n) {
    if (n < 10) {
        return n
    }
    return (n % 10) + sumDigits(n / 10)
}
pln(sumDigits(123))
pln(sumDigits(999))
pln(sumDigits(1001))

pln("Power (recursive):")
func power(base, exp) {
    if (exp == 0) {
        return 1
    }
    if (exp < 0) {
        return 1 / power(base, -exp)
    }
    return base * power(base, exp - 1)
}
pln(power(2, 10))
pln(power(3, 4))
pln(power(5, 0))

pln("Reverse string (recursive):")
func reverseString(s) {
    if (len(s) <= 1) {
        return s
    }
    return reverseString(substr(s, 1)) + substr(s, 0, 1)
}
pln(reverseString("hello"))
pln(reverseString("a"))
pln(reverseString(""))
