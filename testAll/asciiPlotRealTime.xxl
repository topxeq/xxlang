// asciiPlotRealTime.xxl - Real-time ASCII plotting demo
// Ported from charlang/cmd/scripts/asciiPlotRealTime.char
//
// This script demonstrates real-time ASCII plotting with user interaction.
// Press 'a' to 'z' to modify the plot, press Ctrl+C or 'q' to exit.

import "ascii"
import "concurrent"

// Global key state
var g_lastKey = ""
var g_exitFlag = false

// Input handler - runs in separate goroutine
func inputHandler() {
    while (!g_exitFlag) {
        // Non-blocking key read
        key := getChar()

        if (key != null && key != "") {
            g_lastKey = key

            // Check for exit
            if (key == "q" || key == "Q") {
                g_exitFlag = true
            }
        }

        // Small delay to prevent CPU hogging
        sleep(10)
    }
}

// Display thread - updates and shows the plot
func displayThread(data) {
    cnt := 0
    lastKey := ""
    keyValue := 0

    while (!g_exitFlag) {
        cnt = cnt + 1
        if (cnt > 10) { cnt = 0 }

        // Update animation value
        data[0][2] = cnt

        // Check for new key press
        if (g_lastKey != "" && g_lastKey != lastKey) {
            key := g_lastKey

            // Process 'a'-'z' keys
            if (len(key) == 1) {
                charPart := key
                if (key >= "A" && key <= "Z") {
                    idx := "ABCDEFGHIJKLMNOPQRSTUVWXYZ".indexOf(key)
                    charPart = "abcdefghijklmnopqrstuvwxyz"[idx]
                }
                idx := "abcdefghijklmnopqrstuvwxyz".indexOf(charPart)
                if (idx >= 0 && idx <= 25) {
                    data[0][4] = idx
                    lastKey = charPart
                    keyValue = idx
                }
            }
            // Store any key for display
            if (lastKey == "" || key != lastKey) {
                lastKey = key
            }
        }

        // Clear and draw
        ascii.plotClearConsole()

        caption := "Press a-z (q=quit). Last: '" + lastKey + "' val=" + keyValue
        pln(ascii.plotDataToStr(data, "-caption=" + caption, "-min=0", "-max=30", "-height=20", "-width=60"))

        pln("Frame:", cnt, " | a[0][2]:", data[0][2], " | a[0][4]:", data[0][4])

        sleep(100)
    }
}

// Main
a := [[0, 1.2, 2, 3, 4, 5, 6]]

pln("=== ASCII Plot Real-Time Demo ===")
pln("Press a-z to change plot, q to exit")
pln("")

// Initialize keyboard input in main thread before starting goroutines
pln("Press any key to start...")
firstKey := getChar()
// Wait until we get a valid key
while (firstKey == null || firstKey == "") {
    sleep(10)
    firstKey = getChar()
}
pln("")

run inputHandler()
run displayThread(a)

// Wait for exit
while (!g_exitFlag) {
    sleep(10)
}

pln("Exiting...")
