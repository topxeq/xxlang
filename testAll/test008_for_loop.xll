// Test 008: For Loop
// Tests C-style for loop with break and continue

pln("Basic for loop:")
for (var i = 0; i < 5; i = i + 1) {
    pln(i)
}

pln("For with break:")
for (var i = 0; i < 10; i = i + 1) {
    if (i == 3) {
        break
    }
    pln(i)
}

pln("For with continue:")
for (var i = 0; i < 5; i = i + 1) {
    if (i == 2) {
        continue
    }
    pln(i)
}

pln("Countdown:")
for (var i = 5; i > 0; i = i - 1) {
    pln(i)
}

pln("Step by 2:")
for (var i = 0; i < 10; i = i + 2) {
    pln(i)
}

pln("Nested for:")
for (var i = 1; i <= 3; i = i + 1) {
    for (var j = 1; j <= 3; j = j + 1) {
        pr(i * j)
        pr(" ")
    }
    pln("")
}

pln("Factorial:")
var fact = 1
for (var i = 1; i <= 5; i = i + 1) {
    fact = fact * i
}
pln(fact)
