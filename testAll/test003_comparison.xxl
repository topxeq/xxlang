// Test 003: Comparison Operations
// Tests comparison operators: ==, !=, <, >, <=, >=

// ============================================
// Part 1: Numeric Equality
// ============================================
pln("=== Numeric Equality ===")

pln("Integer equality:")
pln(5 == 5)
pln(5 == 3)
pln(0 == 0)
pln(-1 == -1)
pln(100 == 100)

pln("Float equality:")
pln(3.14 == 3.14)
pln(2.5 == 2.5)
pln(0.0 == 0.0)

pln("Mixed numeric equality:")
pln(5 == 5.0)
pln(0 == 0.0)
pln(1 == 1.0)

// ============================================
// Part 2: Numeric Inequality
// ============================================
pln("=== Numeric Inequality ===")

pln("Inequality:")
pln(5 != 3)
pln(5 != 5)
pln(0 != 1)
pln(-1 != 1)

// ============================================
// Part 3: Numeric Less Than
// ============================================
pln("=== Numeric Less Than ===")

pln("Integer less than:")
pln(3 < 5)
pln(5 < 3)
pln(3 < 3)
pln(-5 < -3)
pln(-5 < 5)

pln("Float less than:")
pln(3.5 < 4.5)
pln(1.0 < 1.0)
pln(0.5 < 1.5)

pln("Mixed less than:")
pln(3 < 3.5)
pln(3.5 < 4)

// ============================================
// Part 4: Numeric Greater Than
// ============================================
pln("=== Numeric Greater Than ===")

pln("Integer greater than:")
pln(5 > 3)
pln(3 > 5)
pln(5 > 5)
pln(5 > -5)
pln(-3 > -5)

pln("Float greater than:")
pln(4.5 > 3.5)
pln(1.0 > 1.0)

pln("Mixed greater than:")
pln(4 > 3.5)
pln(4.5 > 4)

// ============================================
// Part 5: Numeric Less Than or Equal
// ============================================
pln("=== Numeric Less Than or Equal ===")

pln("Less than or equal:")
pln(3 <= 5)
pln(5 <= 3)
pln(5 <= 5)
pln(3 <= 3.0)
pln(-5 <= -5)

// ============================================
// Part 6: Numeric Greater Than or Equal
// ============================================
pln("=== Numeric Greater Than or Equal ===")

pln("Greater than or equal:")
pln(5 >= 3)
pln(3 >= 5)
pln(5 >= 5)
pln(3.0 >= 3)
pln(-5 >= -5)

// ============================================
// Part 7: Boolean Comparison
// ============================================
pln("=== Boolean Comparison ===")

pln("Boolean equality:")
pln(true == true)
pln(false == false)
pln(true == false)
pln(false == true)

pln("Boolean inequality:")
pln(true != false)
pln(false != true)
pln(true != true)
pln(false != false)

// ============================================
// Part 8: Null Comparison
// ============================================
pln("=== Null Comparison ===")

pln("Null equality:")
pln(null == null)
pln(null == 0)
pln(null == "")
pln(null == false)

pln("Null inequality:")
pln(null != null)
pln(null != 0)
pln(null != "")

// ============================================
// Part 9: String Equality
// ============================================
pln("=== String Equality ===")

pln("String equality:")
pln("hello" == "hello")
pln("hello" == "world")
pln("" == "")
pln("a" == "A")
pln("abc" == "abc")
pln("abc" == "abcd")

pln("String inequality:")
pln("a" != "b")
pln("a" != "a")
pln("hello" != "world")
pln("" != "a")

// ============================================
// Part 10: String Comparison (Lexicographic)
// ============================================
pln("=== String Comparison (Lexicographic) ===")

pln("Basic string less than:")
pln("a" < "b")
pln("b" < "a")
pln("a" < "a")
pln("" < "a")
pln("abc" < "abd")
pln("abc" < "abcd")

pln("Basic string greater than:")
pln("b" > "a")
pln("a" > "b")
pln("a" > "a")
pln("a" > "")
pln("abc" > "abb")
pln("abcd" > "abc")

pln("String less than or equal:")
pln("abc" <= "abc")
pln("abc" <= "abd")
pln("abd" <= "abc")
pln("" <= "a")

pln("String greater than or equal:")
pln("abc" >= "abc")
pln("abc" >= "abb")
pln("abb" >= "abc")
pln("a" >= "")

pln("Case sensitivity:")
pln("A" < "a")
pln("a" > "A")
pln("ABC" < "abc")

pln("Numeric-like strings (lexicographic, not numeric):")
pln("10" > "2")
pln("2" < "10")
pln("a10" < "a2")

// ============================================
// Part 11: Chained Comparisons
// ============================================
pln("=== Chained Comparisons ===")

pln("Multiple comparisons:")
pln(1 < 2 && 2 < 3)
pln(1 < 2 || 3 < 2)
pln(5 > 3 && 5 < 10)
pln("a" < "b" && "b" < "c")

// ============================================
// Part 12: Type Coercion Edge Cases
// ============================================
pln("=== Type Coercion Edge Cases ===")

pln("Int and float comparison:")
pln(5 == 5.0)
pln(5.0 == 5)
pln(5 < 5.5)
pln(5.5 > 5)
pln(0 == 0.0)

// ============================================
// All tests completed!
// ============================================
pln("=== All comparison tests completed! ===")
