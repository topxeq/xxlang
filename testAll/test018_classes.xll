// Test 018: Classes and OOP
// Tests class definition, instantiation, and methods

pln("Basic class:")
class Point {
    var x = 0
    var y = 0

    func init(x, y) {
        this.x = x
        this.y = y
    }

    func toString() {
        return "Point(" + toStr(this.x) + ", " + toStr(this.y) + ")"
    }

    func add(other) {
        return Point(this.x + other.x, this.y + other.y)
    }
}

var p1 = Point(3, 4)
pln(p1.x)
pln(p1.y)
pln(p1.toString())

var p2 = Point(1, 2)
var p3 = p1.add(p2)
pln(p3.toString())

pln("Class with methods:")
class Counter {
    var count = 0

    func increment() {
        this.count = this.count + 1
    }

    func decrement() {
        this.count = this.count - 1
    }

    func get() {
        return this.count
    }
}

var counter = Counter()
pln(counter.get())
counter.increment()
counter.increment()
pln(counter.get())
counter.decrement()
pln(counter.get())

pln("Type checking with classes:")
pln(typeOf(p1, true))
pln(typeOf(p1))

pln("Class instance is truthy:")
if (p1) {
    pln("instance is truthy")
}
