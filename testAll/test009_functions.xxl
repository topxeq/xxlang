// Test 009: Functions
// Tests function declarations and calls

pln("Basic function:")
func greet() {
    pln("Hello, World!")
}
greet()

pln("Function with parameters:")
func add(a, b) {
    return a + b
}
pln(add(3, 5))

pln("Function with return value:")
func square(x) {
    return x * x
}
pln(square(7))

pln("Function with multiple returns:")
func minMax(a, b) {
    if (a < b) {
        return a
    }
    return b
}
pln(minMax(3, 7))
pln(minMax(9, 2))

pln("Nested function calls:")
func double(x) {
    return x * 2
}
func quadruple(x) {
    return double(double(x))
}
pln(quadruple(5))

pln("Recursive function:")
func factorial(n) {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}
pln(factorial(5))
pln(factorial(6))

pln("Fibonacci:")
func fib(n) {
    if (n <= 1) {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}
pln(fib(10))

pln("Function with default behavior:")
func greetPerson(name) {
    if (name == "") {
        return "Hello, Guest!"
    }
    return "Hello, " + name + "!"
}
pln(greetPerson("Alice"))
pln(greetPerson(""))
