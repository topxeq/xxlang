// Test 020: Try-Catch-Finally
// Tests exception handling

pln("Basic try-catch:")
try {
    pln("in try block")
    throw "test error"
    pln("after throw")
} catch (e) {
    pln("caught: " + e)
}

pln("Try-finally:")
try {
    pln("in try")
} finally {
    pln("in finally")
}

pln("Try-catch-finally:")
var executed = false
try {
    pln("try block")
    executed = true
} catch (e) {
    pln("catch block")
} finally {
    pln("finally block")
}

pln("Nested try-catch:")
try {
    try {
        throw "inner error"
    } catch (e) {
        pln("inner catch: " + e)
    }
    pln("after inner try")
} catch (e) {
    pln("outer catch: " + e)
}

pln("Try without error:")
try {
    var x = 10
    pln("no error occurred")
} catch (e) {
    pln("should not print")
}

pln("Error re-throw:")
try {
    try {
        throw "re-throw test"
    } catch (e) {
        pln("caught, re-throwing")
        throw e
    }
} catch (e) {
    pln("caught again: " + e)
}
