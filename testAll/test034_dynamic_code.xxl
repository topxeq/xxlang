// Test 034: Dynamic Code Execution
// Tests runCode and genOtpCode functions

// ============================================
// Part 1: runCode function
// ============================================
pln("=== Part 1: runCode function ===")

pln("Simple expression:")
var result1 = runCode("return 1 + 2")
pln(result1)

pln("Variable assignment:")
var result2 = runCode("var x = 10; return x * 2")
pln(result2)

pln("Function definition and call:")
var result3 = runCode("func add(a, b) { return a + b }; return add(3, 4)")
pln(result3)

pln("String manipulation:")
var result4 = runCode("return upper(\"hello\")")
pln(result4)

pln("Array operations:")
var result5 = runCode("var arr = [1, 2, 3]; return len(arr)")
pln(result5)

pln("With arguments:")
var result6 = runCode("return x + y", {"x": 10, "y": 20})
pln(result6)

pln("Nested runCode:")
var result7 = runCode("return runCode(\"return 5 * 3\")")
pln(result7)

pln("Map creation:")
var result8 = runCode("return {\"a\": 1, \"b\": 2}")
pln(result8)

// ============================================
// Part 2: genOtpCode function
// ============================================
pln("=== Part 2: genOtpCode function ===")

pln("Generate OTP code (6 digits):")
// Using a test secret (base32 encoded)
var otp = genOtpCode("JBSWY3DPEHPK3PXP")
pln(len(toStr(otp)) == 6)

// ============================================
// All tests completed!
// ============================================
pln("=== All dynamic code tests completed! ===")
