// Test 012: Array Built-in Functions
// Tests push, pop, first, last, rest, indexOf, etc.

pln("push function:")
var arr = [1, 2, 3]
arr = push(arr, 4)
pln(arr)

pln("pop function:")
var popped = pop(arr)
pln(popped)
pln(arr)

pln("first and last:")
pln(first(arr))
pln(last(arr))

pln("rest function:")
var arr2 = [1, 2, 3, 4, 5]
pln(rest(arr2, 1))
pln(rest(arr2, 2))
pln(rest(arr2, 1, 3))

pln("indexOf function:")
var arr3 = [10, 20, 30, 20, 40]
pln(indexOf(arr3, 20))
pln(indexOf(arr3, 50))

pln("containsArr function:")
pln(containsArr(arr3, 30))
pln(containsArr(arr3, 50))

pln("reverse function:")
pln(reverse([1, 2, 3, 4, 5]))

pln("sort function:")
pln(sort([3, 1, 4, 1, 5, 9, 2, 6]))

pln("sum and avg:")
pln(sum([1, 2, 3, 4, 5]))
pln(avg([1, 2, 3, 4, 5]))

pln("range function:")
pln(range(5))
pln(range(2, 5))
pln(range(0, 10, 2))

pln("unique function:")
pln(unique([1, 2, 2, 3, 3, 3, 4]))

pln("flatten function:")
pln(flatten([[1, 2], [3, [4, 5]]]))

pln("take and drop:")
var arr4 = [1, 2, 3, 4, 5]
pln(take(arr4, 3))
pln(drop(arr4, 2))

pln("chunk function:")
pln(chunk([1, 2, 3, 4, 5, 6, 7], 3))

pln("shuffle and sample:")
var shuffled = shuffle([1, 2, 3, 4, 5])
pln(len(shuffled))
pln(len(sample([1, 2, 3, 4, 5], 3)))
