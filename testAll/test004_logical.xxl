// Test 004: Logical Operations
// Tests logical operators: &&, ||, !

pln("Logical AND:")
pln(true && true)
pln(true && false)
pln(false && true)
pln(false && false)

pln("Logical OR:")
pln(true || true)
pln(true || false)
pln(false || true)
pln(false || false)

pln("Logical NOT:")
pln(!true)
pln(!false)
pln(!0)
pln(!1)
pln(!null)
pln(!"")

pln("Short-circuit evaluation:")
var x = 0
var result1 = false && (x = 1) == 1
pln(x)
var result2 = true || (x = 2) == 2
pln(x)

pln("Complex logical expressions:")
pln(true && true && true)
pln(true && false && true)
pln(false || false || true)
pln(true || false || false)
pln((true && false) || true)
pln(!(true && false))
