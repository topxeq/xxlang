// test_input_debug.xxl - Debug console input
pln("=== Input Debug Test ===")
pln("Check stderr for console mode debug info")
pln("")
pln("Press any key (should see debug output)...")
pln("Press 'q' to quit")
pln("")

cnt := 0
while (true) {
    cnt = cnt + 1

    key := getChar()
    if (key != null && key != "") {
        pln(">>> Got key: '", key, "'")
        if (key == "q" || key == "Q") {
            pln("Exiting...")
            break
        }
    }

    sleep(100)

    // Exit after 10 seconds if no key
    if (cnt > 100) {
        pln("Timeout - no keys detected")
        break
    }
}
