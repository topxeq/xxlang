// test_nonblocking_input.xxl - Test non-blocking keyboard input
// This script tests the new non-blocking keyboard input functions

pln("=== Testing Non-Blocking Keyboard Input ===")
pln("")

// Test 1: Check if key is available (should be null/empty initially)
pln("Test 1: Check for pending input (should be null)...")
key := getChar()
pln("  getChar() result: ", key)
pln("")

// Test 2: Blocking key read
pln("Test 2: Press any key (blocking getKey())...")
pln("  Waiting for key press...")
key2 := getKey()
pln("  Key pressed: '", key2, "'")
pln("")

// Test 3: Special key test
pln("Test 3: Try pressing arrow keys, Escape, or function keys")
pln("  Press a key (or special key) within 5 seconds...")
pln("  (Note: This is a simplified test - full async would need goroutines)")

// Simple loop to show key codes
pln("")
pln("Test 4: Key code viewer (press 'q' to exit)")
pln("  Press keys to see their codes...")

while (true) {
    k := getKey()

    if (k == "q" || k == "Q") {
        pln("  Exit key pressed, exiting...")
        break
    }

    // Show key code
    pln("  Key: '", k, "' (length: ", len(k), ")")
}

pln("")
pln("=== Test Complete ===")
