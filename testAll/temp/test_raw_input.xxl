// test_raw_input.xxl - Test raw console input
pln("=== Raw Input Test ===")
pln("Press keys (no Enter needed), 'q' to quit")
pln("")

cnt := 0
while (true) {
    cnt = cnt + 1
    key := getChar()
    if (key != null && key != "") {
        pln(">>> Key: '", key, "'")
        if (key == "q" || key == "Q") {
            pln("Exiting...")
            break
        }
    }
    sleep(50)
    if (cnt > 300) { pln("Timeout"); break }
}
