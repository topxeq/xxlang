// test_key_direct.xxl - Direct key test
pln("=== Direct Key Test ===")
pln("Press any key...")

key := getKey()
pln("Got key: '", key, "'")

pln("Press 'q' to exit...")
while (true) {
    k := getKey()
    pln("Got: '", k, "'")
    if (k == "q" || k == "Q") {
        pln("Exiting...")
        break
    }
}
