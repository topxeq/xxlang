// test_console_diag.xxl - Diagnose console input
import "concurrent"

pln("=== Console Input Diagnostic ===")
pln("")

// Try to initialize input by calling getChar
pln("Testing getChar initialization...")

// Call getChar to trigger initialization
key := getChar()
pln("Initial getChar() result: ", key)

// Try getKey (blocking)
pln("")
pln("Now testing getKey (should be immediate if console mode is set)...")
pln("Press any key within 3 seconds...")

// Use a timeout mechanism
resultTube := concurrent.makeTube(1)

run {
    k := getKey()
    resultTube <- k
}

// Wait with timeout
received := false
for (var i = 0; i < 60; i = i + 1) {  // 60 * 50ms = 3 seconds
    r := concurrent.tubeTryRecv(resultTube)
    if (r[1]) {
        pln("getKey() returned: '", r[0], "'")
        received = true
        break
    }
    sleep(50)
}

if (!received) {
    pln("TIMEOUT: getKey() did not return within 3 seconds")
    pln("This means console input is still in line-buffered mode")
}

pln("")
pln("Diagnostic complete")
