// Test 005: Variables and Constants
// Tests var, const, and short variable declaration (:=)

pln("Variable declarations:")
var a = 10
pln(a)

var b = 20
a = b
pln(a)

pln("Short variable declaration:")
c := 30
pln(c)

c = 40
pln(c)

pln("Constants:")
const PI = 3.14159
pln(PI)

const GREETING = "Hello"
pln(GREETING)

pln("Multiple assignments:")
var x = 1
var y = 2
var temp = x
x = y
y = temp
pln(x)
pln(y)

pln("String concatenation with variables:")
var firstName = "John"
var lastName = "Doe"
var fullName = firstName + " " + lastName
pln(fullName)

pln("Variable in expressions:")
var num1 = 10
var num2 = 20
pln(num1 + num2)
pln(num1 * num2)
pln(num2 - num1)
pln(num2 / num1)
