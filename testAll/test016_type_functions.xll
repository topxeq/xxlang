// Test 016: Type Checking and Conversion Functions
// Tests type checking and conversion built-ins

pln("Type checking functions:")
pln(isInt(42))
pln(isInt(42.0))
pln(isFloat(3.14))
pln(isFloat(42))
pln(isString("hello"))
pln(isString(42))
pln(isBool(true))
pln(isBool(1))
pln(isArray([1, 2, 3]))
pln(isArray(42))
pln(isMap({"a": 1}))
pln(isMap(42))
pln(isNull(null))
pln(isNull(0))

pln("typeOf function:")
pln(typeOf(42))
pln(typeOf(3.14))
pln(typeOf("hello"))
pln(typeOf(true))
pln(typeOf([1, 2]))
pln(typeOf({"a": 1}))
pln(typeOf(null))
pln(typeOf(func() { return 1 }))

pln("isEmpty function:")
pln(isEmpty(""))
pln(isEmpty("hello"))
pln(isEmpty([]))
pln(isEmpty([1]))
pln(isEmpty({}))
pln(isEmpty({"a": 1}))
pln(isEmpty(null))

pln("int conversion:")
pln(int(3.7))
pln(int("42"))
pln(int(true))
pln(int(false))

pln("float conversion:")
pln(float(42))
pln(float("3.14"))

pln("string conversion:")
pln(string(42))
pln(string(3.14))
pln(string(true))
pln(string([1, 2, 3]))
pln(string({"a": 1}))

pln("toStr function:")
pln(toStr(100))
pln(toStr(true))
pln(toStr(null))

pln("isFunction:")
func myFunc() { return 1 }
pln(isFunction(myFunc))
pln(isFunction(len))
pln(isFunction(42))
