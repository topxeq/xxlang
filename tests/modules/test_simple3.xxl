// Test simple module with non-exported variable
import * as simple from "./simple"

pln("Testing simple module:")
pln("getX: ", simple.getX)
pln("setX: ", simple.setX)

pln("Calling getX():")
var x1 = simple.getX()
pln("Result: ", x1)

pln("\nCalling setX(20):")
var y = simple.setX(20)
pln("Result: ", y)
