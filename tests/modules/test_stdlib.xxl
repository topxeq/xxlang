// Test stdlib module import
import * as math from "math"
import { PI, E } from "math"

// Test math module
pln("=== Testing math module ===")
pln("PI: ", PI)
pln("E: ", E)
pln("abs(-5): ", math.abs(-5))
pln("sqrt(16): ", math.sqrt(16))
pln("pow(2, 3): ", math.pow(2, 3))
pln("sin(0): ", math.sin(0))
pln("cos(0): ", math.cos(0))
pln("ceil(1.5): ", math.ceil(1.5))
pln("floor(1.5): ", math.floor(1.5))
pln("max(1, 5, 3): ", math.max(1, 5, 3))
pln("min(1, 5, 3): ", math.min(1, 5, 3))

// Test strings module
import * as str from "strings"

pln("\n=== Testing strings module ===")
pln("len(\"hello\"): ", str.len("hello"))
pln("toUpper(\"hello\"): ", str.toUpper("hello"))
pln("toLower(\"HELLO\"): ", str.toLower("HELLO"))
pln("trim(\"  hello  \"): ", str.trim("  hello  "))
pln("contains(\"hello world\", \"world\"): ", str.contains("hello world", "world"))
pln("indexOf(\"hello\", \"ll\"): ", str.indexOf("hello", "ll"))
pln("hasPrefix(\"hello\", \"he\"): ", str.hasPrefix("hello", "he"))
pln("hasSuffix(\"hello\", \"lo\"): ", str.hasSuffix("hello", "lo"))

// Test importing specific functions
import { toUpper, toLower, split, join } from "strings"

pln("\n=== Testing destructured imports ===")
pln("toUpper(\"test\"): ", toUpper("test"))
pln("toLower(\"TEST\"): ", toLower("TEST"))

// Test split and join
var parts = split("a,b,c", ",")
pln("split(\"a,b,c\", \",\"): ", parts)
pln("join(parts, \"-\"): ", join(parts, "-"))

// Test array module
import * as arr from "array"

pln("\n=== Testing array module ===")
var nums = [1, 2, 3, 4, 5]
pln("Original array: ", nums)
pln("len: ", arr.len(nums))
pln("first: ", arr.first(nums))
pln("last: ", arr.last(nums))
pln("get(2): ", arr.get(nums, 2))
pln("contains(3): ", arr.contains(nums, 3))
pln("indexOf(4): ", arr.indexOf(nums, 4))
pln("isEmpty: ", arr.isEmpty(nums))

// Test array modifications
var testArr = [1, 2, 3]
arr.push(testArr, 4)
pln("After push(4): ", testArr)
arr.pop(testArr)
pln("After pop: ", testArr)
arr.unshift(testArr, 0)
pln("After unshift(0): ", testArr)
arr.shift(testArr)
pln("After shift: ", testArr)

// Test slice and concat
pln("slice(1, 3): ", arr.slice(nums, 1, 3))
var other = [6, 7, 8]
pln("concat: ", arr.concat(nums, other))

// Test reverse
var revArr = [1, 2, 3]
arr.reverse(revArr)
pln("reverse: ", revArr)

// Test unique
var dupArr = [1, 2, 2, 3, 3, 3]
pln("unique: ", arr.unique(dupArr))

// Test flatten
var nestedArr = [[1, 2], [3, 4], 5]
pln("flatten: ", arr.flatten(nestedArr))

// Test io module
import * as io from "io"

pln("\n=== Testing io module ===")
pln("cwd: ", io.cwd())
pln("args: ", io.args())
pln("exists(\".\"): ", io.exists("."))
pln("env(\"HOME\"): ", io.env("HOME"))

pln("\n=== All stdlib tests complete ===")
