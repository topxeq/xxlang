// Test file-based module import
import * as utils from "./utils"
import { add, multiply, greet, increment, getCounter } from "./utils"

pln("=== Testing file-based module import ===")

// Test namespace import
pln("utils.greeting: ", utils.greeting)
pln("utils.add(5, 3): ", utils.add(5, 3))
pln("utils.multiply(4, 7): ", utils.multiply(4, 7))

// Test destructured import
pln("\n=== Testing destructured imports ===")
pln("add(10, 20): ", add(10, 20))
pln("multiply(6, 7): ", multiply(6, 7))
pln("greet(\"Alice\"): ", greet("Alice"))

// Test module-level state
pln("\n=== Testing module-level state ===")
pln("Initial counter: ", getCounter())
pln("increment(): ", increment())
pln("increment(): ", increment())
pln("increment(): ", increment())
pln("Final counter: ", getCounter())

// Test that utils namespace also sees same state
pln("utils.getCounter(): ", utils.getCounter())

pln("\n=== All file-based module tests passed ===")
