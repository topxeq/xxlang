// test_pinyin_extended.xxl
// Test extended pinyin support

pln("Testing extended pinyin support:")
pln("")

// Common characters
pln("Common characters:")
pln("中国: ", toPinYin("中国"))
pln("北京: ", toPinYin("北京"))
pln("上海: ", toPinYin("上海"))
pln("深圳: ", toPinYin("深圳"))
pln("")

// Less common characters
pln("Less common characters:")
pln("龍: ", toPinYin("龍"))
pln("龜: ", toPinYin("龜"))
pln("鳳: ", toPinYin("鳳"))
pln("麒麟: ", toPinYin("麒麟"))
pln("")

// Rare characters (should still work)
pln("Rare characters:")
pln("馥: ", toPinYin("馥"))
pln("甄: ", toPinYin("甄"))
pln("嬛: ", toPinYin("嬛"))
pln("")

// With tone
pln("With tone marks:")
pln("中国: ", toPinYin("中国", "-tone"))
pln("北京: ", toPinYin("北京", "-tone"))
pln("")

// Test sentence
pln("Test sentence:")
testText := "中华人民共和国万岁"
pln(testText, ": ", toPinYin(testText))
pln(testText, " (with tone): ", toPinYin(testText, "-tone"))
pln(testText, " (with separator): ", toPinYin(testText, "-sep=-"))
pln("")

// Test long text
longText := "语言模型是一种人工智能技术，它可以理解和生成人类语言。"
pln("Long text test:")
pln(longText)
pln("Pinyin: ", toPinYin(longText))
pln("")

// Count supported characters
count := 0
for i := 0x4E00; i <= 0x9FFF; i++ {
    char := chr(i)
    py := toPinYin(char)
    if py != char {
        count = count + 1
    }
}
pln("Supported characters in CJK Unified Ideographs block: ", count)
