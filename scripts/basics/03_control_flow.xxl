// 03_control_flow.xxl
// If-else statements and conditional expressions

// === Basic If Statement ===
var age = 18

println("=== Basic If Statement ===")
if (age >= 18) {
    println("You are an adult")
}

// === If-Else Statement ===
var score = 75

println("\n=== If-Else Statement ===")
if (score >= 60) {
    println("Passed!")
} else {
    println("Failed")
}

// === Nested If-Else Chain ===
// Note: Xxlang uses nested if-else for multi-way conditions
println("\n=== Nested If-Else Chain ===")
var grade = 85

if (grade >= 90) {
    println("Grade: A")
} else {
    if (grade >= 80) {
        println("Grade: B")
    } else {
        if (grade >= 70) {
            println("Grade: C")
        } else {
            if (grade >= 60) {
                println("Grade: D")
            } else {
                println("Grade: F")
            }
        }
    }
}

// === Nested If Statements ===
println("\n=== Nested If Statements ===")
var isLoggedIn = true
var isAdmin = true

if (isLoggedIn) {
    if (isAdmin) {
        println("Welcome, Admin!")
    } else {
        println("Welcome, User!")
    }
} else {
    println("Please log in")
}

// === Switch-like Pattern (using if-else) ===
println("\n=== Switch-like Pattern ===")
var day = 3

// Xxlang uses if-else chains for switch-like behavior
if (day == 1) {
    println("Monday")
} else {
    if (day == 2) {
        println("Tuesday")
    } else {
        if (day == 3) {
            println("Wednesday")
        } else {
            if (day == 4) {
                println("Thursday")
            } else {
                if (day == 5) {
                    println("Friday")
                } else {
                    if (day == 6) {
                        println("Saturday")
                    } else {
                        if (day == 7) {
                            println("Sunday")
                        } else {
                            println("Invalid day")
                        }
                    }
                }
            }
        }
    }
}

// === Season Example ===
println("\n=== Season Example ===")
var month = 2
var season = ""

if (month == 12 || month == 1 || month == 2) {
    season = "Winter"
} else {
    if (month >= 3 && month <= 5) {
        season = "Spring"
    } else {
        if (month >= 6 && month <= 8) {
            season = "Summer"
        } else {
            if (month >= 9 && month <= 11) {
                season = "Autumn"
            } else {
                season = "Unknown"
            }
        }
    }
}

println("Month ", month, " is ", season)

// === Conditional Logic ===
println("\n=== Conditional Logic ===")
var num = 15
var parity = ""

if (num % 2 == 0) {
    parity = "even"
} else {
    parity = "odd"
}

println(num, " is ", parity)

// === Complex Conditions ===
println("\n=== Complex Conditions ===")
var hasLicense = true
var hasInsurance = true
var age2 = 25

if (age2 >= 18 && hasLicense && hasInsurance) {
    println("You can drive legally")
} else {
    println("You cannot drive legally")
}

// === Short-Circuit Example ===
println("\n=== Short-Circuit Evaluation ===")
var divisor = 0
var dividend = 10

// Check divisor first to prevent division by zero
if (divisor == 0) {
    println("Cannot divide: divisor is zero")
} else {
    if (dividend / divisor > 5) {
        println("Result is greater than 5")
    } else {
        println("Result is too small")
    }
}
