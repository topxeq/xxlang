// test_data_format.xxl - Test Data format built-in functions

// Load modules
toml := loadModule("toml")
yaml := loadModule("yaml")

pln("=== Testing parseXml ===")

xmlStr := "<root><item id='1'>Hello</item><item id='2'>World</item></root>"
xml := parseXml(xmlStr)
pln("Parsed XML:", xml)

root := xml.root()
pln("Root element:", root.name())

items := xml.find("item")
pln("Found items:", len(items))

first := xml.findFirst("item")
pln("First item text:", first.text())
pln("First item id:", first.attr("id"))

pln("")
pln("=== Testing newXmlDoc ===")

doc := newXmlDoc("config")
root := doc.root()
pln("Root name:", root.name())

pln("")
pln("=== Testing yaml.parse ===")

yamlStr := "name: Alice\nage: 25\ncity: Beijing\ntags:\n  - dev\n  - go"
data := yaml.parse(yamlStr)
pln("Parsed YAML:")
pln("  name:", data["name"])
pln("  age:", data["age"])
pln("  city:", data["city"])

pln("")
pln("=== Testing yaml.stringify ===")

obj := {"name": "Bob", "age": 30, "skills": ["python", "rust"]}
yamlOut := yaml.stringify(obj)
pln("To YAML:")
pln(yamlOut)

pln("")
pln("=== Testing yaml.toJson ===")

jsonStr := yaml.toJson(yamlStr)
pln("YAML to JSON:", jsonStr)

pln("")
pln("=== Testing yaml.fromJson ===")

jsonInput := "{\"product\":\"Widget\",\"price\":99.9,\"inStock\":true}"
yamlOut2 := yaml.fromJson(jsonInput)
pln("JSON to YAML:")
pln(yamlOut2)

pln("")
pln("=== Testing toml.parse ===")

tomlStr := "[server]\nhost = 'localhost'\nport = 8080\n\n[database]\nname = 'mydb'\nuser = 'admin'"
tomlData := toml.parse(tomlStr)
pln("Parsed TOML:")
pln("  server:", tomlData["server"])
serverData := tomlData["server"]
pln("  server.host:", serverData["host"])
pln("  server.port:", serverData["port"])

pln("")
pln("=== Testing toml.encode ===")

config := {
    "app": {
        "name": "MyApp",
        "version": "1.0.0"
    },
    "logging": {
        "level": "info",
        "file": "/var/log/app.log"
    }
}
tomlOut := toml.encode(config)
pln("To TOML:")
pln(tomlOut)

pln("")
pln("=== All data format tests completed ===")
