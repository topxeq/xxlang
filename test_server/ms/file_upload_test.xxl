// file_upload.xxl
// Example script demonstrating file upload handling in Xxlang server mode

// Get uploaded files from the request
var files = requestG.files

// Check if any files were uploaded
if len(files) == 0 {
    writeResp(responseG, '{"success": false, "message": "No files uploaded"}')
    return
}

// Configure upload settings
var uploadDir = "./uploads"
var maxSize = 10 * 1024 * 1024  // 10MB

// Process each uploaded file
var results = []
for fieldName, fileArray in files {
    for file in fileArray {
        // Get file info
        var filename = file.filename()
        var fileSize = file.size()
        var ext = file.extension()
        var contentType = file.contentType()

        // Validate file size
        if fileSize > maxSize {
            results = append(results, {
                "fieldName": fieldName,
                "filename": filename,
                "success": false,
                "message": "File size exceeds maximum allowed"
            })
            continue
        }

        // Validate file extension (optional)
        var allowedExts = ["txt", "pdf", "png", "jpg", "jpeg", "gif", "doc", "docx", "xls", "xlsx"]
        if len(allowedExts) > 0 && !contains(allowedExts, ext) {
            results = append(results, {
                "fieldName": fieldName,
                "filename": filename,
                "success": false,
                "message": "File extension not allowed: " + ext
            })
            continue
        }

        // Save the file with auto-rename to avoid conflicts
        var savedPath = file.saveToDir(uploadDir, true)

        // Calculate file hash (optional)
        var hash = file.hashSHA256()

        results = append(results, {
            "fieldName": fieldName,
            "filename": filename,
            "success": true,
            "savedPath": savedPath,
            "size": fileSize,
            "hash": hash
        })
    }
}

// Return JSON response
setRespHeader(responseG, "Content-Type", "application/json")
writeResp(responseG, json::encode({
    "success": true,
    "files": results
}))
