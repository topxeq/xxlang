<!DOCTYPE html>
<html>
<head>
    <title>XHP Test Page</title>
    <meta charset="utf-8">
</head>
<body>
    <h1>XHP Dynamic Page Test</h1>

    <h2>Simple Expression</h2>
    <p>1 + 2 = <?xhp return "1" + "2" ?></p>

    <h2>Arithmetic</h2>
    <p>10 * 5 = <?xhp return toStr(10 * 5) ?></p>

    <h2>Current Time</h2>
    <p>Server time: <?xhp return now() ?></p>

    <h2>Parameter Access</h2>
    <p>Hello, <?xhp return paraMapG["name"] || "Guest" ?>!</p>

    <h2>Multiple Code Blocks</h2>
    <?xhp
        var a = 10
        var b = 20
        return toStr(a) + " + " + toStr(b) + " = " + toStr(a + b)
    ?>

    <h2>Conditional Output</h2>
    <?xhp
        if (paraMapG["show"] == "yes") {
            return "<p style='color:green'>Secret content shown!</p>"
        }
        return "<p style='color:gray'>Add ?show=yes to see secret content</p>"
    ?>

    <h2>Loop Example</h2>
    <ul>
    <?xhp
        var items = ["Apple", "Banana", "Cherry"]
        var result = ""
        for (var i = 0; i < len(items); i = i + 1) {
            result = result + "<li>" + items[i] + "</li>"
        }
        return result
    ?>
    </ul>

    <footer>
        <hr>
        <p>Generated by Xxlang XHP at <?xhp return now() ?></p>
    </footer>
</body>
</html>
