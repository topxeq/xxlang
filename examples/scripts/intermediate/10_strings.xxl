// 10_strings.xxl
// String operations, methods, and patterns

// === String Basics ===
pln("=== String Basics ===")
var greeting = "Hello, World!"
var name = "Alice"
var empty = ""

pln("greeting: ", greeting)
pln("name: ", name)
pln("empty: '", empty, "'")

// === String Length ===
pln("\n=== String Length ===")
pln("len(greeting): ", len(greeting))
pln("len(name): ", len(name))

// === String Concatenation ===
pln("\n=== String Concatenation ===")
var first = "Hello"
var last = "World"
var full = first + ", " + last + "!"
pln("Concatenated: ", full)

// Build string in loop
var builder = ""
for (var i = 0; i < 5; i++) {
    builder = builder + string(i)
}
pln("Built string: ", builder)

// === String Comparison ===
pln("\n=== String Comparison ===")
var a = "apple"
var b = "apple"
var c = "banana"

pln("a == b: ", a == b)  // true
pln("a == c: ", a == c)  // false
pln("a != c: ", a != c)  // true

// === String Methods ===
pln("\n=== String Methods ===")

var text = "Hello, World!"

// Contains
pln("text.contains('World'): ", text.contains("World"))
pln("text.contains('world'): ", text.contains("world"))

// Index
pln("text.indexOf('World'): ", text.indexOf("World"))
pln("text.indexOf('xyz'): ", text.indexOf("xyz"))

// Substring
pln("\n=== Substring Operations ===")
var str = "Hello, World!"
pln("str.subStr(0, 5): ", str.subStr(0, 5))    // "Hello"
pln("str.subStr(7, 12): ", str.subStr(7, 12))  // "World"

// Character at position
pln("\n=== Character Access ===")
for (var i = 0; i < 5; i++) {
    pln("  str[", i, "]: ", str[i])
}

// === String Searching ===
pln("\n=== String Searching ===")
var sentence = "The quick brown fox jumps over the lazy dog"

pln("sentence.contains('fox'): ", sentence.contains("fox"))
pln("sentence.contains('cat'): ", sentence.contains("cat"))
pln("sentence.indexOf('quick'): ", sentence.indexOf("quick"))
pln("sentence.indexOf('lazy'): ", sentence.indexOf("lazy"))

// === Case Conversion ===
pln("\n=== Case Conversion ===")
var mixed = "HeLLo WoRLD"
pln("Original: ", mixed)
pln("upper: ", upper(mixed))
pln("lower: ", lower(mixed))

// === String Trimming ===
pln("\n=== String Trimming ===")
var padded = "   hello world   "
pln("Original: '", padded, "'")
pln("trim: '", trim(padded), "'")

// === String Splitting (manual) ===
pln("\n=== String Splitting Pattern ===")

func splitBySpace(s) {
    var parts = []
    var current = ""

    for (var i = 0; i < len(s); i++) {
        var ch = s[i]
        if (ch == " ") {
            if (len(current) > 0) {
                push(parts, current)
                current = ""
            }
        } else {
            current = current + ch
        }
    }
    if (len(current) > 0) {
        push(parts, current)
    }

    return parts
}

var csv = "one two three four five"
var parts = splitBySpace(csv)
pln("Original: ", csv)
pln("Parts: ", parts)

// === String Joining ===
pln("\n=== String Joining ===")

func joinArray(arr, sep) {
    if (len(arr) == 0) {
        return ""
    }
    var result = arr[0]
    for (var i = 1; i < len(arr); i++) {
        result = result + sep + arr[i]
    }
    return result
}

var words = ["apple", "banana", "cherry"]
pln("words: ", words)
pln("joined: ", joinArray(words, ", "))
pln("joined with |: ", joinArray(words, " | "))

// === String Replacement ===
pln("\n=== String Replacement ===")

func replaceStr(s, old, newStr) {
    var idx = s.indexOf(old)
    if (idx < 0) {
        return s
    }
    return s.subStr(0, idx) + newStr + s.subStr(idx + len(old), len(s))
}

var original = "Hello World"
var replaced = replaceStr(original, "World", "Xxlang")
pln("Original: ", original)
pln("Replaced: ", replaced)

// === String Prefix/Suffix Check ===
pln("\n=== Prefix/Suffix Check ===")

func hasPrefix(s, prefix) {
    if (len(prefix) > len(s)) {
        return false
    }
    return s.subStr(0, len(prefix)) == prefix
}

func hasSuffix(s, suffix) {
    if (len(suffix) > len(s)) {
        return false
    }
    return s.subStr(len(s) - len(suffix), len(s)) == suffix
}

var filename = "document.pdf"
pln("filename: ", filename)
pln("hasPrefix('doc'): ", hasPrefix(filename, "doc"))
pln("hasSuffix('.pdf'): ", hasSuffix(filename, ".pdf"))
pln("hasSuffix('.txt'): ", hasSuffix(filename, ".txt"))

// === String Reversal ===
pln("\n=== String Reversal ===")

func reverseString(s) {
    var result = ""
    for (var i = len(s) - 1; i >= 0; i--) {
        result = result + s[i]
    }
    return result
}

var original2 = "Hello"
var reversed = reverseString(original2)
pln("Original: ", original2)
pln("Reversed: ", reversed)

// === Palindrome Check ===
pln("\n=== Palindrome Check ===")

func isPalindrome(s) {
    var lower = s.lower()
    return lower == reverseString(lower)
}

pln("isPalindrome('racecar'): ", isPalindrome("racecar"))
pln("isPalindrome('hello'): ", isPalindrome("hello"))
pln("isPalindrome('Level'): ", isPalindrome("Level"))

// === String to Number Conversion ===
pln("\n=== String to Number Conversion ===")

var numStr = "42"
var num = int(numStr)
pln("int('42'): ", num)
pln("typeOf: ", typeOf(num))

var floatStr = "3.14159"
var floatNum = float(floatStr)
pln("float('3.14159'): ", floatNum)
pln("typeOf: ", typeOf(floatNum))

// === Number to String Conversion ===
pln("\n=== Number to String Conversion ===")

var n = 42
var s = string(n)
pln("string(42): ", s)
pln("typeOf: ", typeOf(s))

var f = 3.14
var sf = string(f)
pln("string(3.14): ", sf)

// === String Formatting Pattern ===
pln("\n=== String Formatting Pattern ===")

func format(template, args) {
    var result = ""
    var argIdx = 0
    var i = 0

    while (i < len(template)) {
        var ch = template[i]
        if (ch == "{" && i + 1 < len(template) && template[i + 1] == "}") {
            if (argIdx < len(args)) {
                result = result + string(args[argIdx])
                argIdx = argIdx + 1
            }
            i = i + 2
        } else {
            result = result + ch
            i = i + 1
        }
    }

    return result
}

var formatted = format("Name: {}, Age: {}, City: {}", ["Alice", 30, "Beijing"])
pln("Formatted: ", formatted)

// === String Escape Sequences ===
pln("\n=== String Escape Sequences ===")

var escaped = "Line1\nLine2\tTabbed"
pln("With escapes: ", escaped)

var quoted = "She said \"Hello\""
pln("With quotes: ", quoted)

// === Multi-line String Pattern ===
pln("\n=== Building Multi-line String ===")

func buildLines(lines) {
    var result = ""
    for (line in lines) {
        result = result + line + "\n"
    }
    return result
}

var lines = ["First line", "Second line", "Third line"]
var multiLine = buildLines(lines)
pln("Multi-line string:")
pr(multiLine)
