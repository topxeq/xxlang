// 07_maps.xxl
// Map creation, manipulation, and methods

// === Map Creation ===
pln("=== Map Creation ===")
var empty = {}
var person = {"name": "Alice", "age": 30, "city": "Beijing"}
var config = {"debug": true, "timeout": 30, "retries": 3}

pln("empty: ", empty)
pln("person: ", person)
pln("config: ", config)

// === Map Access ===
pln("\n=== Map Access ===")
pln("person['name']: ", person["name"])
pln("person['age']: ", person["age"])
pln("person['city']: ", person["city"])

// === Map Modification ===
pln("\n=== Map Modification ===")
var user = {"name": "Bob"}
pln("Original: ", user)

user["age"] = 25          // Add new key
pln("After adding age: ", user)

user["name"] = "Charlie"  // Modify existing key
pln("After changing name: ", user)

// === Map Length ===
pln("\n=== Map Length ===")
pln("len(person): ", len(person))
pln("person.len(): ", person.len())

// === Map Methods: keys and values ===
pln("\n=== Map Methods: keys/values ===")
var scores = {"Alice": 95, "Bob": 87, "Charlie": 92}

pln("scores.keys(): ", scores.keys())
pln("scores.values(): ", scores.values())

// === Map Methods: hasKey ===
pln("\n=== Map Methods: hasKey ===")
var data = {"a": 1, "b": 2, "c": 3}

pln("hasKey(data, 'a'): ", hasKey(data, "a"))
pln("hasKey(data, 'x'): ", hasKey(data, "x"))
pln("data.hasKey('b'): ", data.hasKey("b"))

// === Map Methods: delete ===
pln("\n=== Map Methods: delete ===")
var items = {"apple": 5, "banana": 3, "cherry": 8}
pln("Before delete: ", items)

delete(items, "banana")
pln("After delete 'banana': ", items)

// === Iterating Over Maps ===
pln("\n=== Iterating Over Maps ===")
var grades = {"Math": 90, "Science": 85, "English": 92}

pln("Using for-in (key, value):")
for (subject, grade in grades) {
    pln("  ", subject, ": ", grade)
}

pln("\nUsing keys():")
for (key in grades.keys()) {
    pln("  ", key, " = ", grades[key])
}

// === Nested Maps ===
pln("\n=== Nested Maps ===")
var company = {
    "name": "TechCorp",
    "address": {
        "street": "123 Main St",
        "city": "Beijing",
        "country": "China"
    },
    "employees": 150
}

pln("Company name: ", company["name"])
pln("City: ", company["address"]["city"])
pln("Employees: ", company["employees"])

// === Map as Counters ===
pln("\n=== Map as Counters ===")
var text = "hello world"
var charCount = {}

for (char in ["h", "e", "l", "l", "o", " ", "w", "o", "r", "l", "d"]) {
    if (hasKey(charCount, char)) {
        charCount[char] = charCount[char] + 1
    } else {
        charCount[char] = 1
    }
}

pln("Character counts:")
for (char, count in charCount) {
    if (char != " ") {
        pln("  '", char, "': ", count)
    }
}

// === Map Merging ===
pln("\n=== Map Merging ===")
func mergeMaps(m1, m2) {
    var result = {}

    for (k, v in m1) {
        result[k] = v
    }
    for (k, v in m2) {
        result[k] = v
    }

    return result
}

var defaults = {"timeout": 30, "retries": 3}
var userConfig = {"timeout": 60, "debug": true}
var merged = mergeMaps(defaults, userConfig)

pln("defaults: ", defaults)
pln("userConfig: ", userConfig)
pln("merged: ", merged)

// === Safe Access Pattern ===
pln("\n=== Safe Access Pattern ===")
func safeGet(map, key, defaultVal) {
    if (hasKey(map, key)) {
        return map[key]
    }
    return defaultVal
}

var settings = {"theme": "dark"}
pln("safeGet(settings, 'theme', 'light'): ", safeGet(settings, "theme", "light"))
pln("safeGet(settings, 'language', 'en'): ", safeGet(settings, "language", "en"))

// === Map to Array Conversion ===
pln("\n=== Map to Array Conversion ===")
var mapData = {"a": 1, "b": 2, "c": 3}

// Get keys as array
var keyArr = mapData.keys()
pln("Keys array: ", keyArr)

// Get values as array
var valArr = mapData.values()
pln("Values array: ", valArr)

// === Grouping Pattern ===
pln("\n=== Grouping Pattern ===")
var people = [
    {"name": "Alice", "dept": "Engineering"},
    {"name": "Bob", "dept": "Marketing"},
    {"name": "Charlie", "dept": "Engineering"},
    {"name": "Diana", "dept": "Marketing"}
]

var byDept = {}
for (p in people) {
    var dept = p["dept"]
    if (!hasKey(byDept, dept)) {
        byDept[dept] = []
    }
    push(byDept[dept], p["name"])
}

pln("Grouped by department:")
for (dept, names in byDept) {
    pln("  ", dept, ": ", names)
}

// === Map Lookup Table ===
pln("\n=== Map Lookup Table ===")

// Define operations as separate functions
func addOp(a, b) { return a + b }
func subOp(a, b) { return a - b }
func mulOp(a, b) { return a * b }
func divOp(a, b) { return a / b }

// Store operation names in a map for lookup
var opNames = {
    "add": "add",
    "sub": "sub",
    "mul": "mul",
    "div": "div"
}

func calculate(op, a, b) {
    if (op == "add") { return addOp(a, b) }
    if (op == "sub") { return subOp(a, b) }
    if (op == "mul") { return mulOp(a, b) }
    if (op == "div") { return divOp(a, b) }
    return null
}

pln("calculate('add', 5, 3): ", calculate("add", 5, 3))
pln("calculate('mul', 4, 7): ", calculate("mul", 4, 7))
