pln("lower(): ", lower(mixed))

// Capitalize first letter
func capitalize(s) {
    if (len(s) == 0) { return s }
    return upper(s[0]) + lower(substr(s, 1, len(s)))
}

pln("capitalize: ", capitalize("hello world"))

// === Trimming ===
pln("\n=== Trimming ===")

var padded = "   hello world   "
pln("Original: '", padded, "'")
pln("trim(): '", trim(padded), "'")

// === Split and Join ===
pln("\n=== Split and Join ===")

// Split by delimiter
func split(s, delimiter) {
    var parts = []
    var current = ""
    var i = 0

    while (i < len(s)) {
        var match = true
        for (var j = 0; j < len(delimiter) && i + j < len(s); j++) {
            if (s[i + j] != delimiter[j]) {
                match = false
                break
            }
        }

        if (match && len(delimiter) > 0) {
            if (len(current) > 0) {
                push(parts, current)
            }
            current = ""
            i = i + len(delimiter)
        } else {
            current = current + s[i]
            i = i + 1
        }
    }

    if (len(current) > 0) {
        push(parts, current)
    }

    return parts
}

// Join array with delimiter
func join(arr, delimiter) {
    if (len(arr) == 0) { return "" }
    var result = arr[0]
    for (var i = 1; i < len(arr); i++) {
        result = result + delimiter + arr[i]
    }
    return result
}

var csv = "apple,banana,cherry,date"
var items = split(csv, ",")
pln("Split: ", items)
pln("Join: ", join(items, " | "))

// === String Replace ===
pln("\n=== String Replace ===")

func replace(s, old, newStr) {
    var idx = s.indexOf(old)
    if (idx < 0) { return s }
    return substr(s, 0, idx) + newStr + substr(s, idx + len(old), len(s))
}

var original = "Hello World"
var replaced = replace(original, "World", "Xxlang")
pln("Original: ", original)
pln("Replaced: ", replaced)

// === String Reverse ===
pln("\n=== String Reverse ===")

func reverseStr(s) {
    var result = ""
    for (var i = len(s) - 1; i >= 0; i--) {
        result = result + s[i]
    }
    return result
}

pln("reverseStr('hello') = ", reverseStr("hello"))
pln("reverseStr('Xxlang') = ", reverseStr("Xxlang"))

// === Palindrome Check ===
pln("\n=== Palindrome Check ===")

func isPalindrome(s) {
    var cleaned = lower(s)
    return cleaned == reverseStr(cleaned)
}

pln("isPalindrome('racecar'): ", isPalindrome("racecar"))
pln("isPalindrome('Level'): ", isPalindrome("Level"))
pln("isPalindrome('hello'): ", isPalindrome("hello"))

// === String Starts/Ends With ===
pln("\n=== String Starts/Ends With ===")

func startsWith(s, prefix) {
    if (len(prefix) > len(s)) { return false }
    return substr(s, 0, len(prefix)) == prefix
}

func endsWith(s, suffix) {
    if (len(suffix) > len(s)) { return false }
    return substr(s, len(s) - len(suffix), len(s)) == suffix
}

var filename = "document.pdf"
pln("Filename: ", filename)
pln("startsWith('doc'): ", startsWith(filename, "doc"))
pln("endsWith('.pdf'): ", endsWith(filename, ".pdf"))
pln("endsWith('.txt'): ", endsWith(filename, ".txt"))

// === String Padding ===
pln("\n=== String Padding ===")

func padLeft(s, width, padChar) {
    if (len(padChar) == 0) { padChar = " " }
    while (len(s) < width) {
        s = padChar + s
    }
    return s
}

func padRight(s, width, padChar) {
    if (len(padChar) == 0) { padChar = " " }
    while (len(s) < width) {
        s = s + padChar
    }
    return s
}

var num = "42"
pln("padLeft('42', 5, '0') = ", padLeft(num, 5, "0"))
pln("padRight('42', 5, '_') = ", padRight(num, 5, "_"))

// === Word Count ===
pln("\n=== Word Count ===")

func wordCount(s) {
    if (len(trim(s)) == 0) { return 0 }
    var words = split(trim(s), " ")
    return len(words)
}

var text2 = "The quick brown fox jumps"
pln("Text: ", text2)
pln("Word count: ", wordCount(text2))

// === String to Number Conversion ===
pln("\n=== String to Number Conversion ===")

