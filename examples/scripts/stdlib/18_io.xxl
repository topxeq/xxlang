// === Working with Paths ===
pln("\n=== Working with Paths ===")

func getFilename(path) {
    // Extract filename from path
    var lastSlash = -1
    for (var i = 0; i < len(path); i++) {
        if (path[i] == "/" || path[i] == "\\") {
            lastSlash = i
        }
    }
    if (lastSlash < 0) {
        return path
    }
    return substr(path, lastSlash + 1, len(path))
}

func getExtension(filename) {
    var lastDot = -1
    for (var i = 0; i < len(filename); i++) {
        if (filename[i] == ".") {
            lastDot = i
        }
    }
    if (lastDot < 0) {
        return ""
    }
    return substr(filename, lastDot, len(filename))
}

func getBasename(filename) {
    var lastDot = -1
    for (var i = 0; i < len(filename); i++) {
        if (filename[i] == ".") {
            lastDot = i
        }
    }
    if (lastDot < 0) {
        return filename
    }
    return substr(filename, 0, lastDot)
}

var testPath = "/home/user/documents/report.pdf"
pln("Path: ", testPath)
pln("Filename: ", getFilename(testPath))
pln("Extension: ", getExtension(getFilename(testPath)))
pln("Basename: ", getBasename(getFilename(testPath)))

// === CSV Processing ===
pln("\n=== CSV Processing ===")

func parseCSV(line, delimiter) {
    var fields = []
    var current = ""
    var inQuotes = false

    for (var i = 0; i < len(line); i++) {
        var ch = line[i]

        if (ch == "\"") {
            inQuotes = !inQuotes
        } else if (ch == delimiter && !inQuotes) {
            push(fields, current)
            current = ""
        } else {
            current = current + ch
        }
    }
    push(fields, current)

    return fields
}

func toCSV(fields, delimiter) {
    var result = ""
    for (var i = 0; i < len(fields); i++) {
        var field = toStr(fields[i])
        if (i > 0) { result = result + delimiter }
        result = result + field
    }
    return result
}

var csvLine = "Alice,30,Beijing"
var parsed = parseCSV(csvLine, ",")
pln("CSV line: ", csvLine)
pln("Parsed: ", parsed)
pln("Reconstructed: ", toCSV(parsed, ","))

// === JSON-like Processing ===
pln("\n=== JSON-like Processing ===")

func simpleStringify(obj) {
    var t = typeOf(obj)

    if (t == "NULL") {
        return "null"
    }
    if (t == "BOOL") {
        return toStr(obj)
    }
    if (t == "INT" || t == "FLOAT") {
        return toStr(obj)
    }
    if (t == "STRING") {
        return "\"" + obj + "\""
    }
    if (t == "ARRAY") {
        var parts = []
        for (item in obj) {
            push(parts, simpleStringify(item))
        }
        return "[" + join(parts, ", ") + "]"
    }
    if (t == "MAP") {
        var pairs = []
        for (k, v in obj) {
            push(pairs, "\"" + k + "\": " + simpleStringify(v))
        }
        return "{" + join(pairs, ", ") + "}"
    }

    return toStr(obj)
}

var testData = {
    "name": "Alice",
    "age": 30,
    "active": true,
    "tags": ["developer", "golang"]
}

pln("Object: ", testData)
pln("JSON-like: ", simpleStringify(testData))

// === Logging ===
pln("\n=== Logging ===")

func createLogger(name) {
    return {
        "name": name,
        "log": func(level, message) {
            pln("[", level, "] ", name, ": ", message)
        },
        "debug": func(msg) {
            pln("[DEBUG] ", name, ": ", msg)
        },
        "info": func(msg) {
            pln("[INFO] ", name, ": ", msg)
        },
        "warn": func(msg) {
            pln("[WARN] ", name, ": ", msg)
        },
        "error": func(msg) {
            pln("[ERROR] ", name, ": ", msg)
        }
    }
}

var logger = createLogger("App")
logger["debug"]("Debug message")
logger["info"]("Application started")
logger["warn"]("Low memory")
logger["error"]("Connection failed")

