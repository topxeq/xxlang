// === Working with Paths ===
pln("\n=== Working with Paths ===")

func getFilename(path) {
    // Extract filename from path
    var idx = path.indexOf("/")
    if (idx < 0) {
        idx = path.indexOf("\\")
    }

    while (idx >= 0) {
        path = substr(path, idx + 1, len(path))
        idx = path.indexOf("/")
        if (idx < 0) { idx = path.indexOf("\\") }
    }

    return path
}

func getExtension(filename) {
    var idx = filename.indexOf(".")
    if (idx < 0) {
        return ""
    }
    return substr(filename, idx, len(filename))
}

func getBasename(filename) {
    var idx = filename.indexOf(".")
    if (idx < 0) {
        return filename
    }
    return substr(filename, 0, idx)
}

var testPath = "/home/user/documents/report.pdf"
pln("Path: ", testPath)
pln("Filename: ", getFilename(testPath))
pln("Extension: ", getExtension(getFilename(testPath)))
pln("Basename: ", getBasename(getFilename(testPath)))

// === CSV Processing ===
pln("\n=== CSV Processing ===")

func parseCSV(line, delimiter) {
    var fields = []
    var current = ""
    var inQuotes = false

    for (var i = 0; i < len(line); i++) {
        var ch = line[i]

        if (ch == "\"") {
            inQuotes = !inQuotes
        } else if (ch == delimiter && !inQuotes) {
            push(fields, current)
            current = ""
        } else {
            current = current + ch
        }
    }
    push(fields, current)

    return fields
}

func toCSV(fields, delimiter) {
    var result = ""
    for (var i = 0; i < len(fields); i++) {
        var field = string(fields[i])
        // Quote if contains delimiter or newline
        if (field.contains(delimiter) || field.contains("\n")) {
            field = "\"" + field + "\""
        }
        if (i > 0) { result = result + delimiter }
        result = result + field
    }
    return result
}

var csvLine = "Alice,30,Beijing"
var parsed = parseCSV(csvLine, ",")
pln("CSV line: ", csvLine)
pln("Parsed: ", parsed)
pln("Reconstructed: ", toCSV(parsed, ","))

// === JSON-like Processing ===
pln("\n=== JSON-like Processing ===")

func simpleStringify(obj) {
    var t = typeOf(obj)

    if (t == "NULL") {
        return "null"
    }
    if (t == "BOOL") {
        return string(obj)
    }
    if (t == "INT" || t == "FLOAT") {
        return string(obj)
    }
    if (t == "STRING") {
        return "\"" + obj + "\""
    }
    if (t == "ARRAY") {
        var parts = []
        for (item in obj) {
            push(parts, simpleStringify(item))
        }
        return "[" + join(parts, ", ") + "]"
    }
    if (t == "MAP") {
        var pairs = []
        for (k, v in obj) {
            push(pairs, "\"" + k + "\": " + simpleStringify(v))
        }
        return "{" + join(pairs, ", ") + "}"
    }

    return string(obj)
}

var testData = {
    "name": "Alice",
    "age": 30,
    "active": true,
    "tags": ["developer", "golang"],
    "address": {
        "city": "Beijing",
        "country": "China"
    }
}

pln("Object: ", testData)
pln("JSON-like: ", simpleStringify(testData))

// === Logging ===
pln("\n=== Logging ===")

func createLogger(name) {
    return {
        "name": name,
        "log": func(level, message) {
            pln("[", level, "] ", name, ": ", message)
        },
        "debug": func(msg) {
            pln("[DEBUG] ", name, ": ", msg)
        },
        "info": func(msg) {
            pln("[INFO] ", name, ": ", msg)
        },
        "warn": func(msg) {
            pln("[WARN] ", name, ": ", msg)
        },
        "error": func(msg) {
            pln("[ERROR] ", name, ": ", msg)
        }
    }
}

var logger = createLogger("App")
logger["debug"]("Debug message")
logger["info"]("Application started")
logger["warn"]("Low memory")
logger["error"]("Connection failed")

// === Output Formatting ===
pln("\n=== Output Formatting ===")

// Table formatting
func printTable(headers, rows) {
    // Calculate column widths
    var widths = []
    for (var i = 0; i < len(headers); i++) {
        var maxW = len(headers[i])
        for (row in rows) {
            if (len(string(row[i])) > maxW) {
                maxW = len(string(row[i]))
            }
        }
        push(widths, maxW)
    }

    // Print header
    var headerLine = "|"
    var separator = "+"
    for (var i = 0; i < len(headers); i++) {
        headerLine = headerLine + " " + padRight(headers[i], widths[i], " ") + " |"
        separator = separator + "-" + padRight("", widths[i], "-") + "-+"
    }

    pln(separator)
    pln(headerLine)
    pln(separator)

    // Print rows
    for (row in rows) {
        var rowLine = "|"
        for (var i = 0; i < len(row); i++) {
            rowLine = rowLine + " " + padRight(string(row[i]), widths[i], " ") + " |"
        }
        pln(rowLine)
    }
    pln(separator)
}

var headers = ["Name", "Age", "City"]
var rows = [
    ["Alice", "25", "Beijing"],
    ["Bob", "30", "Shanghai"],
    ["Charlie", "28", "Shenzhen"]
]

pln("")
printTable(headers, rows)

// === Progress Indicator ===
pln("\n=== Progress Indicator ===")

func printProgress(current, total, width) {
    var percent = current * 100 / total
    var filled = current * width / total
    var empty = width - filled

    var bar = "["
    for (var i = 0; i < filled; i++) { bar = bar + "=" }
    for (var i = 0; i < empty; i++) { bar = bar + " " }
    bar = bar + "] " + percent + "%"

    pr("\r" + bar)
}

pln("Progress simulation:")
for (var i = 0; i <= 10; i++) {
    printProgress(i, 10, 20)
    // In real code, would have delay here
}
pln("")
