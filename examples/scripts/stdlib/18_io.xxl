// === Formatted Output ===
pln("\n=== Formatted Output ===")

func printf(format, args) {
    var result = ""
    var argIdx = 0
    var i = 0

    while (i < len(format)) {
        var ch = format[i]
        if (ch == "%") {
            if (i + 1 < len(format)) {
                var next = format[i + 1]
                if (next == "s" || next == "d" || next == "f") {
                    if (argIdx < len(args)) {
                        result = result + toStr(args[argIdx])
                        argIdx = argIdx + 1
                    }
                    i = i + 2
                } else {
                    result = result + ch
                    i = i + 1
                }
            } else {
                result = result + ch
                i = i + 1
            }
        } else {
            result = result + ch
            i = i + 1
        }
    }

    pr(result)
}

printf("Name: %s, Age: %d\n", ["Alice", 30])
printf("Score: %f, Grade: %s\n", [95.5, "A"])

