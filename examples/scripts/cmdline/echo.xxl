// echo.xxl
// A simple echo-like utility demonstrating string handling
// Similar to the Unix 'echo' command

// Simulated command line arguments
var args = ["echo.xxl", "-n", "Hello", "World"]

// Parse flags
var noNewline = false
var interpretEscapes = false
var message = []

// Parse arguments (skip program name)
var i = 1
while (i < len(args)) {
    var arg = args[i]

    if (arg == "-n") {
        // Do not output trailing newline
        noNewline = true
    } else if (arg == "-e") {
        // Enable interpretation of backslash escapes
        interpretEscapes = true
    } else if (arg == "-E") {
        // Disable interpretation (default)
        interpretEscapes = false
    } else if (arg == "--help") {
        pln("Usage: echo [OPTION]... [STRING]...")
        pln("Echo the STRING(s) to standard output.")
        pln("")
        pln("  -n    do not output the trailing newline")
        pln("  -e    enable interpretation of backslash escapes")
        pln("  -E    disable interpretation of backslash escapes (default)")
        pln("")
        pln("Example: echo -n -e 'Hello\\nWorld'")
    } else if (startsWith(arg, "-")) {
        // Check for combined flags like -ne
        var flags = substr(arg, 1, len(arg))
        var j = 0
        while (j < len(flags)) {
            var c = substr(flags, j, j + 1)
            if (c == "n") {
                noNewline = true
            } else if (c == "e") {
                interpretEscapes = true
            } else if (c == "E") {
                interpretEscapes = false
            }
            j = j + 1
        }
    } else {
        // Regular argument - add to message
        push(message, arg)
    }

    i = i + 1
}

// Build output
var output = ""
i = 0
while (i < len(message)) {
    if (i > 0) {
        output = output + " "
    }
    output = output + message[i]
    i = i + 1
}

// Print output
if (noNewline) {
    pr(output)
} else {
    pln(output)
}
