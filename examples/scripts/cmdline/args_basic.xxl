// args_basic.xxl
// Basic command line argument handling patterns in Xxlang
// Note: This demo uses simulated arguments since actual CLI args are limited

// ============================================================
// Pattern 1: Simulated command line arguments
// ============================================================
pln("=== Pattern 1: Simulated arguments ===")

// Simulate command line arguments
var args = ["args_basic.xxl", "--name", "Alice", "--count", "5", "file1.txt"]
pln("Program:", args[0])
pln("Argument count:", len(args))

// Print all arguments
var i = 0
while (i < len(args)) {
    pln("  args[", i, "] =", args[i])
    i = i + 1
}
pln("")

// ============================================================
// Pattern 2: Get argument with default
// ============================================================
pln("=== Pattern 2: Argument with default ===")

func getArg(args, index, defaultVal) {
    if (index < len(args)) {
        return args[index]
    }
    return defaultVal
}

var inputFile = getArg(args, 1, "default.txt")
var outputFile = getArg(args, 2, "output.txt")
pln("Input file:", inputFile)
pln("Output file:", outputFile)
pln("")

// ============================================================
// Pattern 3: Flag detection
// ============================================================
pln("=== Pattern 3: Flag detection ===")

func hasFlag(args, flagName) {
    var i = 0
    while (i < len(args)) {
        if (args[i] == flagName) {
            return true
        }
        i = i + 1
    }
    return false
}

var hasHelp = hasFlag(args, "--help") || hasFlag(args, "-h")
var hasVerbose = hasFlag(args, "--verbose") || hasFlag(args, "-v")

pln("Has --help:", hasHelp)
pln("Has --verbose:", hasVerbose)
pln("")

// ============================================================
// Pattern 4: Get option value
// ============================================================
pln("=== Pattern 4: Get option value ===")

func getOption(args, shortName, longName, defaultVal) {
    var i = 0
    while (i < len(args)) {
        if (args[i] == shortName || args[i] == longName) {
            if (i + 1 < len(args)) {
                return args[i + 1]
            }
        }
        i = i + 1
    }
    return defaultVal
}

var name = getOption(args, "-n", "--name", "World")
var countStr = getOption(args, "-c", "--count", "1")
var count = int(countStr)

pln("Name:", name)
pln("Count:", count)
pln("")

// ============================================================
// Pattern 5: Collect positional arguments
// ============================================================
pln("=== Pattern 5: Collect positional arguments ===")

func getPositionalArgs(args) {
    var positional = []
    var i = 1  // Skip program name
    while (i < len(args)) {
        var arg = args[i]
        // Skip options and their values
        if (startsWith(arg, "-")) {
            // Skip option value if it's not another option
            if (i + 1 < len(args) && !startsWith(args[i + 1], "-")) {
                i = i + 1
            }
        } else {
            push(positional, arg)
        }
        i = i + 1
    }
    return positional
}

var files = getPositionalArgs(args)
pln("Files to process:", len(files))
var j = 0
while (j < len(files)) {
    pln("  -", files[j])
    j = j + 1
}

pln("")
pln("Done!")
