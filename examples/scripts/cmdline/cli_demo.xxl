// cli_demo.xxl
// Command line argument processing demonstration for Xxlang
// This demo uses simulated arguments

// Define version
var VERSION = "1.0.0"

// Simulated command line arguments
var cmdArgs = ["cli_demo.xxl", "--name", "John", "--count", "3", "--verbose", "file1.txt"]

// Parse command line arguments
func parseArgs(args) {
    var result = {
        "help": false,
        "version": false,
        "verbose": false,
        "name": "",
        "count": 1,
        "file": "",
        "remaining": []
    }

    var i = 1  // Skip program name
    var remaining = []

    while (i < len(args)) {
        var arg = args[i]

        if (arg == "-h" || arg == "--help") {
            result["help"] = true
        } else if (arg == "-v" || arg == "--version") {
            result["version"] = true
        } else if (arg == "--verbose") {
            result["verbose"] = true
        } else if ((arg == "-n" || arg == "--name") && i + 1 < len(args)) {
            i = i + 1
            result["name"] = args[i]
        } else if ((arg == "-c" || arg == "--count") && i + 1 < len(args)) {
            i = i + 1
            result["count"] = int(args[i])
        } else if (arg == "--file" && i + 1 < len(args)) {
            i = i + 1
            result["file"] = args[i]
        } else if (startsWith(arg, "-")) {
            pln("Unknown option:", arg)
            result["help"] = true
        } else {
            push(remaining, arg)
        }

        i = i + 1
    }

    result["remaining"] = remaining
    return result
}

// Show help message
func showHelp(programName) {
    pln("Usage:", programName, "[options] [arguments]")
    pln("")
    pln("Options:")
    pln("  -h, --help      Show this help message")
    pln("  -v, --version   Show version information")
    pln("  -n, --name      Set name (requires value)")
    pln("  -c, --count     Set count (requires integer value)")
    pln("  --verbose       Enable verbose output")
    pln("  --file          Input file path")
    pln("")
    pln("Examples:")
    pln("  xxlang cli_demo.xxl --name John --count 5")
    pln("  xxlang cli_demo.xxl --verbose file1.txt file2.txt")
}

// Show version
func showVersion() {
    pln("cmdline_demo version", VERSION)
}

// Main function
func main() {
    // Get command line arguments
    var programName = cmdArgs[0]

    // Parse arguments
    var options = parseArgs(cmdArgs)

    // Handle help
    if (options["help"]) {
        showHelp(programName)
        return
    }

    // Handle version
    if (options["version"]) {
        showVersion()
        return
    }

    // Verbose output
    if (options["verbose"]) {
        pln("[VERBOSE] Parsed options:")
        pln("  name:", options["name"])
        pln("  count:", options["count"])
        pln("  file:", options["file"])
        pln("  remaining:", options["remaining"])
    }

    // Main logic - demonstrate using the parsed options
    if (options["name"] != "") {
        var count = options["count"]
        pln("Hello,", options["name"], "!")
        pln("Repeating", count, "times:")

        var i = 0
        while (i < count) {
            pln("  ", i + 1, ". Hello,", options["name"])
            i = i + 1
        }
    }

    // Handle file if specified
    if (options["file"] != "") {
        pln("Processing file:", options["file"])
        // In a real application, you would read and process the file here
    }

    // Handle remaining positional arguments
    var remaining = options["remaining"]
    if (len(remaining) > 0) {
        pln("Positional arguments:")
        var i = 0
        while (i < len(remaining)) {
            pln("  [", i, "]", remaining[i])
            i = i + 1
        }
    }
}

// Run main
main()
