// cmdline_demo.xxl
// Command line argument processing demonstration for Xxlang
// Usage: xxlang cmdline_demo.xxl [options] [arguments]
//
// Options:
//   -h, --help      Show help message
//   -v, --version   Show version
//   -n, --name      Set name (requires value)
//   -c, --count     Set count (requires integer value)
//   --verbose       Enable verbose output
//   --file          Input file path

// Load required modules
let env = load("std/env")
let array = load("std/array")
let string = load("std/string")
let fmt = load("std/fmt")

// Define version
let VERSION = "1.0.0"

// Parse command line arguments
let parseArgs = fn(args) {
    let result = {
        "help": false,
        "version": false,
        "verbose": false,
        "name": "",
        "count": 1,
        "file": "",
        "remaining": []
    }

    let i = 1  // Skip program name
    let remaining = []

    while i < array.len(args) {
        let arg = args[i]

        if arg == "-h" || arg == "--help" {
            result["help"] = true
        } else if arg == "-v" || arg == "--version" {
            result["version"] = true
        } else if arg == "--verbose" {
            result["verbose"] = true
        } else if (arg == "-n" || arg == "--name") && i + 1 < array.len(args) {
            i = i + 1
            result["name"] = args[i]
        } else if (arg == "-c" || arg == "--count") && i + 1 < array.len(args) {
            i = i + 1
            result["count"] = string.parseInt(args[i])
        } else if arg == "--file" && i + 1 < array.len(args) {
            i = i + 1
            result["file"] = args[i]
        } else if string.hasPrefix(arg, "-") {
            fmt.println("Unknown option:", arg)
            result["help"] = true
        } else {
            remaining = array.push(remaining, arg)
        }

        i = i + 1
    }

    result["remaining"] = remaining
    return result
}

// Show help message
let showHelp = fn(programName) {
    fmt.println("Usage:", programName, "[options] [arguments]")
    fmt.println("")
    fmt.println("Options:")
    fmt.println("  -h, --help      Show this help message")
    fmt.println("  -v, --version   Show version information")
    fmt.println("  -n, --name      Set name (requires value)")
    fmt.println("  -c, --count     Set count (requires integer value)")
    fmt.println("  --verbose       Enable verbose output")
    fmt.println("  --file          Input file path")
    fmt.println("")
    fmt.println("Examples:")
    fmt.println("  xxlang cmdline_demo.xxl --name John --count 5")
    fmt.println("  xxlang cmdline_demo.xxl --verbose file1.txt file2.txt")
}

// Show version
let showVersion = fn() {
    fmt.println("cmdline_demo version", VERSION)
}

// Main function
let main = fn() {
    // Get command line arguments
    let args = env.args()
    let programName = args[0]

    // Parse arguments
    let options = parseArgs(args)

    // Handle help
    if options["help"] {
        showHelp(programName)
        return 0
    }

    // Handle version
    if options["version"] {
        showVersion()
        return 0
    }

    // Verbose output
    if options["verbose"] {
        fmt.println("[VERBOSE] Parsed options:")
        fmt.println("  name:", options["name"])
        fmt.println("  count:", options["count"])
        fmt.println("  file:", options["file"])
        fmt.println("  remaining:", options["remaining"])
    }

    // Main logic - demonstrate using the parsed options
    if options["name"] != "" {
        let count = options["count"]
        fmt.println("Hello,", options["name"], "!")
        fmt.println("Repeating", count, "times:")

        let i = 0
        while i < count {
            fmt.println("  ", i + 1, ". Hello,", options["name"])
            i = i + 1
        }
    }

    // Handle file if specified
    if options["file"] != "" {
        fmt.println("Processing file:", options["file"])
        // In a real application, you would read and process the file here
    }

    // Handle remaining positional arguments
    let remaining = options["remaining"]
    if array.len(remaining) > 0 {
        fmt.println("Positional arguments:")
        let i = 0
        while i < array.len(remaining) {
            fmt.println("  [", i, "]", remaining[i])
            i = i + 1
        }
    }

    return 0
}

// Run main
main()
