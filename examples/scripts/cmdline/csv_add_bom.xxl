// csv_add_bom.xxl
// Demonstration of CSV file handling patterns
// BOM (Byte Order Mark) for UTF-8 is: 0xEF 0xBB 0xBF

// UTF-8 BOM bytes (as integers)
var BOM = [239, 187, 191]

// Check if data starts with BOM
func hasBOM(bytes) {
    if (len(bytes) < 3) {
        return false
    }
    return bytes[0] == 239 && bytes[1] == 187 && bytes[2] == 191
}

// Demo: Check if sample data has BOM
var dataWithBOM = [239, 187, 191, 72, 101, 108, 108, 111]  // "Hello" with BOM
var dataWithoutBOM = [72, 101, 108, 108, 111]  // "Hello" without BOM

pln("=== BOM Detection Demo ===")
pln("Data with BOM:", hasBOM(dataWithBOM))
pln("Data without BOM:", hasBOM(dataWithoutBOM))

// Demo: Add BOM to data
func addBOM(bytes) {
    var result = BOM
    var i = 0
    while (i < len(bytes)) {
        push(result, bytes[i])
        i = i + 1
    }
    return result
}

pln("")
pln("=== Adding BOM ===")
pln("Original bytes:", dataWithoutBOM)
var withBOM = addBOM(dataWithoutBOM)
pln("With BOM:", withBOM)
pln("Has BOM now:", hasBOM(withBOM))

pln("")
pln("Done!")
