// monte_carlo_pi.xxl
// Monte Carlo method to calculate Pi using random points
// Xxlang does backend computation, WebView renders results

import "gui"
import "math"
import "json"
import "array"

var totalPoints = 0
var insidePoints = 0
var isRunning = false
var wvHandle = null

func generatePoint() {
    var x = math.random()
    var y = math.random()
    var dx = x - 0.5
    var dy = y - 0.5
    var dist = math.sqrt(dx * dx + dy * dy)
    var inside = 0
    if (dist <= 0.5) {
        inside = 1
    }
    return [x, y, inside]
}

func calculatePi() {
    if (totalPoints == 0) {
        return 0.0
    }
    return 4.0 * float(insidePoints) / float(totalPoints)
}

func sendPoints(points) {
    // Build JSON array directly
    var json = "["
    var i = 0
    while (i < len(points)) {
        var p = points[i]
        if (i > 0) {
            json = json + ","
        }
        json = json + "[" + toStr(p[0]) + "," + toStr(p[1]) + "," + toStr(p[2]) + "]"
        i = i + 1
    }
    json = json + "]"

    var js = "window.xxlang.onPoints(" + json + ");"
    gui.evalJSAsync(wvHandle, js)
}

func sendStats() {
    var pi = calculatePi()
    var err = 0.0
    if (pi > 0) {
        err = math.abs((pi - math.PI) / math.PI * 100.0)
    }
    var js = "window.xxlang.onStats({pi:" + toStr(pi) + ",total:" + toStr(totalPoints) + ",inside:" + toStr(insidePoints) + ",error:" + toStr(err) + "});"
    gui.evalJSAsync(wvHandle, js)
    pln("[Xxlang] Pi=", pi, " Points=", totalPoints, " Inside=", insidePoints, " Error=", err, "%")
}

func addBatch(count) {
    var points = []
    var i = 0
    while (i < count) {
        var p = generatePoint()
        array.push(points, p)
        totalPoints = totalPoints + 1
        if (p[2] == 1) {
            insidePoints = insidePoints + 1
        }
        i = i + 1
    }
    sendPoints(points)
    sendStats()
    pln("Added ", count, " points")
}

func handleMessage(msg) {
    var data = json.fromJson(msg)
    var cmd = data["cmd"]

    if (cmd == "start") {
        isRunning = true
        pln(">>> Simulation STARTED")
    }
    else if (cmd == "stop") {
        isRunning = false
        pln(">>> Simulation STOPPED")
    }
    else if (cmd == "reset") {
        isRunning = false
        totalPoints = 0
        insidePoints = 0
        gui.evalJSAsync(wvHandle, "window.xxlang.onReset();")
        sendStats()
        pln(">>> Simulation RESET")
    }
    else if (cmd == "addBatch") {
        var n = int(data["count"])
        addBatch(n)
    }
}

func createHTML() {
    return `
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: sans-serif; background: linear-gradient(135deg, #1a1a2e, #16213e); color: #eee; padding: 15px; display: flex; flex-direction: column; align-items: center; }
h1 { color: #00d4ff; margin-bottom: 5px; }
.badge { background: #00ff88; color: #1a1a2e; padding: 3px 10px; border-radius: 10px; font-size: 11px; font-weight: bold; margin-bottom: 10px; }
.main { display: flex; gap: 20px; flex-wrap: wrap; justify-content: center; }
#canvas { border: 3px solid #00d4ff; border-radius: 50%; background: radial-gradient(circle, #0f0f1a, #1a1a2e); }
.stats { background: rgba(22,33,62,0.9); padding: 15px; border-radius: 10px; min-width: 200px; }
.row { margin: 8px 0; padding: 8px; background: rgba(26,26,46,0.8); border-radius: 5px; border-left: 3px solid #00d4ff; }
.label { color: #888; font-size: 11px; text-transform: uppercase; }
.value { color: #fff; font-size: 18px; font-weight: bold; font-family: monospace; }
.pi-val { color: #00ff88; font-size: 26px; }
.err-val { color: #ffd93d; }
.ctrls { margin-top: 15px; display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
button { background: linear-gradient(135deg, #00d4ff, #0099cc); color: #1a1a2e; border: none; padding: 8px 16px; border-radius: 5px; cursor: pointer; font-weight: bold; }
button:hover { transform: translateY(-2px); }
.stop { background: linear-gradient(135deg, #ff6b6b, #ee5a5a); }
.reset { background: linear-gradient(135deg, #ffd93d, #ffb347); }
</style>
</head>
<body>
<h1>Monte Carlo Pi Calculator</h1>
<div class="badge">Xxlang Backend Active</div>

<div class="main">
<canvas id="canvas" width="320" height="320"></canvas>

<div class="stats">
<div class="row"><div class="label">Estimated Pi</div><div class="value pi-val" id="pi">0.000000</div></div>
<div class="row"><div class="label">Actual Pi</div><div class="value">3.141593</div></div>
<div class="row"><div class="label">Total Points</div><div class="value" id="total">0</div></div>
<div class="row"><div class="label">Inside Circle</div><div class="value" id="inside">0</div></div>
<div class="row"><div class="label">Error</div><div class="value err-val" id="err">-</div></div>
</div>
</div>

<div class="ctrls">
<button onclick="cmd('start')">Start</button>
<button class="stop" onclick="cmd('stop')">Stop</button>
<button class="reset" onclick="cmd('reset')">Reset</button>
<button onclick="cmd('addBatch',1000)">+1000</button>
<button onclick="cmd('addBatch',10000)">+10000</button>
</div>

<script>
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
const SIZE = 320;
const RADIUS = SIZE / 2;

function drawCircle() {
    ctx.beginPath();
    ctx.arc(RADIUS, RADIUS, RADIUS - 2, 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(0,212,255,0.8)';
    ctx.lineWidth = 2;
    ctx.stroke();
}

function drawPoint(x, y, inside) {
    ctx.beginPath();
    ctx.arc(x * SIZE, y * SIZE, 2, 0, Math.PI * 2);
    ctx.fillStyle = inside ? '#00ff88' : '#ff6b6b';
    ctx.fill();
}

function updateStats(d) {
    document.getElementById('pi').textContent = d.pi.toFixed(6);
    document.getElementById('total').textContent = d.total.toLocaleString();
    document.getElementById('inside').textContent = d.inside.toLocaleString();
    document.getElementById('err').textContent = d.total > 0 ? d.error.toFixed(4) + '%' : '-';
}

function cmd(c, arg) {
    window.chrome.webview.postMessage(arg ? {cmd: c, count: arg} : {cmd: c});
}

window.xxlang = {
    onPoints: function(pts) {
        for (let i = 0; i < pts.length; i++) {
            drawPoint(pts[i][0], pts[i][1], pts[i][2]);
        }
    },
    onStats: function(d) {
        updateStats(d);
    },
    onReset: function() {
        ctx.clearRect(0, 0, SIZE, SIZE);
        drawCircle();
    }
};

drawCircle();
</script>
</body>
</html>
`
}

func main() {
    pln("=====================================")
    pln("Monte Carlo Pi Calculator - Xxlang Backend")
    pln("=====================================")
    pln("")
    pln("Creating window...")

    wvHandle = gui.createWindow("Pi Calculator - Xxlang Backend", 750, 600)
    if (typeOf(wvHandle) == "ERROR") {
        pln("Error: ", wvHandle)
        return
    }
    pln("Window created")

    gui.setHTML(wvHandle, createHTML())
    pln("HTML loaded")
    pln("")
    pln("Controls: Start/Stop/Reset, or add points in batches")
    pln("Close window to exit")
    pln("")

    var frames = 0
    while (!gui.isClosed(wvHandle)) {
        // Process messages
        var p = 0
        while (p < 5) {
            gui.poll(wvHandle)
            p = p + 1
        }

        // Handle WebView messages
        while (gui.hasMessages(wvHandle)) {
            handleMessage(gui.popMessage(wvHandle))
        }

        // Run simulation if active
        if (isRunning) {
            var pts = []
            var i = 0
            while (i < 100) {
                var pt = generatePoint()
                array.push(pts, pt)
                totalPoints = totalPoints + 1
                if (pt[2] == 1) {
                    insidePoints = insidePoints + 1
                }
                i = i + 1
            }
            sendPoints(pts)

            frames = frames + 1
            if (frames >= 5) {
                sendStats()
                frames = 0
            }
        }

        sleep(30)
    }

    gui.close(wvHandle)
    pln("")
    pln("=== Final Results ===")
    pln("Total Points: ", totalPoints)
    pln("Inside Circle: ", insidePoints)
    pln("Pi Estimate: ", calculatePi())
    pln("Actual Pi: ", math.PI)
    pln("Error: ", math.abs(calculatePi() - math.PI))
}

main()