// 18_chars_unicode.xxl
// Chars type for Unicode character handling

// ============================================
// String vs Chars
// ============================================

// String is byte-oriented
var s = "中文测试"
pln("String length (bytes):", len(s))  // 12 bytes (3 bytes per Chinese char)

// Chars is character-oriented
var c = toChars(s)
pln("Chars length (characters):", len(c))  // 4 characters

// ============================================
// Character access
// ============================================

pln("\nCharacter access:")
pln("c[0]:", c[0])  // 中
pln("c[1]:", c[1])  // 文
pln("c[2]:", c[2])  // 测
pln("c[3]:", c[3])  // 试

// Mixed content
var mixed = toChars("Hello世界🎉")
pln("\nMixed content:")
pln("Length:", len(mixed))
pln("Characters:", mixed.toStr())

// ============================================
// Chars methods
// ============================================

pln("\nChars methods:")
var text = toChars("Hello World 世界")

// Substring by character positions
pln("subStr(0, 5):", text.subStr(0, 5).toStr())  // Hello
pln("subStr(6, 11):", text.subStr(6, 11).toStr())  // World

// Case conversion (works with Unicode)
pln("upper():", text.upper().toStr())
pln("lower():", text.lower().toStr())

// Reverse
pln("reverse():", text.reverse().toStr())

// Contains
pln("contains('World'):", text.contains("World"))
pln("contains('世界'):", text.contains("世界"))

// ============================================
// Processing Chinese text
// ============================================

pln("\nChinese text processing:")
var poem = toChars("床前明月光，疑是地上霜。")

// Count characters
pln("Total characters:", len(poem))
pln("Poem:", poem.toStr())

// ============================================
// Practical example: Word frequency
// ============================================

pln("\nWord frequency example:")
var sentence = toChars("The quick brown fox jumps over the lazy dog")
var words = sentence.toStr().split(" ")

var freq = {}
for (word in words) {
    var lower = toChars(word).lower().toStr()
    if (hasKey(freq, lower)) {
        freq[lower] = freq[lower] + 1
    } else {
        freq[lower] = 1
    }
}

for (k, v in freq) {
    pln(k + ":", v)
}
