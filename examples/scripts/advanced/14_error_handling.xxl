// 14_error_handling.xxl
// Error handling patterns: try-catch-finally, validation, and defensive programming

// === Basic Try-Catch ===
pln("=== Basic Try-Catch ===")

func divide(a, b) {
    if (b == 0) {
        throw "Division by zero"
    }
    return a / b
}

// Using try-catch for error handling
try {
    pln("  divide(10, 2) = " + divide(10, 2))
} catch (e) {
    pln("  Error: " + e)
}

try {
    pln("  divide(10, 0) = " + divide(10, 0))
} catch (e) {
    pln("  Error: " + e)
}

// === Safe Operations with Try-Catch ===
pln("\n=== Safe Operations with Try-Catch ===")

func safeDivide(a, b) {
    var result = null
    try {
        result = divide(a, b)
    } catch (e) {
        pln("  Caught error: " + e)
    }
    return result
}

pln("  safeDivide(10, 2) = " + safeDivide(10, 2))
pln("  safeDivide(10, 0) = " + safeDivide(10, 0))

// === Try-Catch-Finally for Cleanup ===
pln("\n=== Try-Catch-Finally for Cleanup ===")

func processFile(filename) {
    pln("  Opening file: " + filename)
    var error = null

    try {
        // Simulate an error during processing
        if (filename == "missing.txt") {
            throw "file not found"
        }
        pln("  Processing file...")
    } catch (e) {
        error = e
    } finally {
        // Cleanup always happens
        pln("  Closing file (cleanup)")
    }

    if (error != null) {
        pln("  Had error: " + error)
    }
}

processFile("data.txt")
processFile("missing.txt")

// === Validation with Exceptions ===
pln("\n=== Validation with Exceptions ===")

func validateUser(user) {
    // Check name
    if (!hasKey(user, "name") || len(user["name"]) == 0) {
        throw "Name is required"
    }

    // Check age
    if (!hasKey(user, "age")) {
        throw "Age is required"
    }
    if (user["age"] < 0 || user["age"] > 150) {
        throw "Age must be between 0 and 150"
    }

    // Check email format
    if (hasKey(user, "email") && len(user["email"]) > 0) {
        if (!user["email"].contains("@")) {
            throw "Invalid email format"
        }
    }

    return true
}

func processUser(user) {
    try {
        validateUser(user)
        pln("  User is valid: " + user["name"])
        return true
    } catch (e) {
        pln("  Validation failed: " + e)
        return false
    }
}

var validUser = {"name": "Alice", "age": 30, "email": "alice@example.com"}
var invalidUser = {"name": "", "age": -5, "email": "invalid"}

pln("Validating users:")
processUser(validUser)
processUser(invalidUser)

// === Exception Propagation ===
pln("\n=== Exception Propagation ===")

func validateInput(input) {
    if (len(input) == 0) {
        throw "input cannot be empty"
    }
    return true
}

func processData(input) {
    validateInput(input)  // Exception propagates if thrown
    pln("  Processing: " + input)
    return "processed: " + input
}

func handleRequest(input) {
    var result = "error"
    try {
        result = processData(input)
    } catch (e) {
        pln("  Request failed: " + e)
    }
    return result
}

pln("Handling requests:")
pln("  Result: " + handleRequest("hello"))
pln("  Result: " + handleRequest(""))

// === Nested Try-Catch ===
pln("\n=== Nested Try-Catch ===")

func innerOperation() {
    pln("  Starting inner operation")
    try {
        throw "inner failure"
    } catch (e) {
        pln("  Inner caught: " + e)
        throw e  // Re-throw
    }
}

func outerOperation() {
    pln("  Starting outer operation")
    try {
        innerOperation()
    } catch (e) {
        pln("  Outer caught: " + e)
        throw "outer error: " + e
    }
}

try {
    outerOperation()
} catch (e) {
    pln("  Final caught: " + e)
}

// === Assertions with Exceptions ===
pln("\n=== Assertions with Exceptions ===")

func assert(condition, message) {
    if (!condition) {
        throw "Assertion failed: " + message
    }
}

func assertEquals(actual, expected, name) {
    if (actual != expected) {
        throw name + ": expected " + expected + ", got " + actual
    }
    pln("  PASS: " + name)
}

func runTests() {
    try {
        assertEquals(1 + 1, 2, "basic math")
        assertEquals("hello".upper(), "HELLO", "upper()")
        assertEquals(2 * 3, 5, "multiplication")  // This will fail
    } catch (e) {
        pln("  FAIL: " + e)
    }
}

pln("Running tests:")
runTests()

// === Resource Management ===
pln("\n=== Resource Management ===")

func withResource(resource, operation) {
    pln("  Acquiring: " + resource)
    var result = null
    try {
        result = operation(resource)
    } finally {
        pln("  Releasing: " + resource)
    }
    return result
}

try {
    withResource("database", func(db) {
        pln("  Using: " + db)
        throw "connection error"
    })
} catch (e) {
    pln("  Error: " + e)
}

// === Option/Nullable Pattern ===
pln("\n=== Option/Nullable Pattern ===")

func safeGet(map, key) {
    if (hasKey(map, key)) {
        return map[key]
    }
    return null
}

func getOrElse(value, defaultVal) {
    if (value == null) {
        return defaultVal
    }
    return value
}

var user = {"name": "Alice", "age": 30}
var email = safeGet(user, "email")

pln("Email: " + getOrElse(email, "not provided"))

// === Retry Pattern with Try-Catch ===
pln("\n=== Retry Pattern with Try-Catch ===")

var retryCount = 0

func unreliableOperation() {
    retryCount = retryCount + 1
    pln("  Attempt " + retryCount)
    if (retryCount < 3) {
        throw "temporary failure"
    }
    return "success"
}

func withRetry(operation, maxAttempts) {
    var attempts = 0
    var result = null

    while (attempts < maxAttempts) {
        attempts = attempts + 1
        try {
            result = operation()
            return result
        } catch (e) {
            pln("    Failed: " + e)
            if (attempts >= maxAttempts) {
                throw "failed after " + maxAttempts + " attempts"
            }
        }
    }
}

try {
    var result = withRetry(unreliableOperation, 5)
    pln("  Final result: " + result)
} catch (e) {
    pln("  Error: " + e)
}

// === Guard Clause Pattern ===
pln("\n=== Guard Clause Pattern ===")

func processPayment(amount, currency, account) {
    // Guard clauses - throw early for error conditions
    if (amount <= 0) {
        throw "Invalid amount"
    }
    if (currency != "USD" && currency != "EUR") {
        throw "Unsupported currency: " + currency
    }
    if (account == null) {
        throw "Account required"
    }
    if (!account["active"]) {
        throw "Account is not active"
    }

    // Main logic
    return "Payment processed: " + amount + " " + currency
}

func handlePayment(amount, currency, account) {
    try {
        pln("  " + processPayment(amount, currency, account))
    } catch (e) {
        pln("  Payment failed: " + e)
    }
}

var account1 = {"id": "A001", "active": true}
var account2 = {"id": "A002", "active": false}

pln("Processing payments:")
handlePayment(100, "USD", account1)
handlePayment(-50, "USD", account1)
handlePayment(100, "JPY", account1)
handlePayment(100, "EUR", account2)

// === Error Handler Pattern ===
pln("\n=== Error Handler Pattern ===")

func createErrorHandler() {
    var handlers = {}

    return {
        "onError": func(errorType, handler) {
            handlers[errorType] = handler
        },
        "handle": func(errorType, error) {
            if (hasKey(handlers, errorType)) {
                handlers[errorType](error)
            } else {
                throw error
            }
        }
    }
}

var errorHandler = createErrorHandler()
errorHandler["onError"]("validation", func(e) {
    pln("  Validation error: " + e)
})
errorHandler["onError"]("network", func(e) {
    pln("  Network error: " + e + " - retrying...")
})

pln("Handling errors:")
try {
    errorHandler["handle"]("validation", "Invalid input")
} catch (e) {
    pln("  Unhandled: " + e)
}

try {
    errorHandler["handle"]("unknown", "Something went wrong")
} catch (e) {
    pln("  Unhandled: " + e)
}

// === Default Values Pattern ===
pln("\n=== Default Values Pattern ===")

func withDefaults(config, defaults) {
    var result = {}
    // Copy defaults - simplified version
    result["timeout"] = defaults["timeout"]
    result["retries"] = defaults["retries"]
    result["debug"] = defaults["debug"]
    // Override with config values
    if (hasKey(config, "timeout")) { result["timeout"] = config["timeout"] }
    if (hasKey(config, "retries")) { result["retries"] = config["retries"] }
    if (hasKey(config, "debug")) { result["debug"] = config["debug"] }
    return result
}

var defaultConfig = {"timeout": 30, "retries": 3, "debug": false}
var userConfig = {"timeout": 60, "debug": true}

var merged = withDefaults(userConfig, defaultConfig)
pln("Merged config: timeout=" + merged["timeout"] + ", retries=" + merged["retries"] + ", debug=" + merged["debug"])

pln("\n=== Done ===")
