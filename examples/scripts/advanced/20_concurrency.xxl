// 20_concurrency.xxl
// Concurrency features: Tube and Context

// ============================================
// Tube (Channel-like communication)
// ============================================

pln("=== Tube (Channels) ===\n")

// Create a buffered tube
var tube = makeTube(2)

// Send values
tube <- 10
tube <- 20

// Receive values
pln("Received:", <- tube)
pln("Received:", <- tube)

pln("Tube capacity:", tubeCap(tube))
pln("Tube length:", tubeLen(tube))

// ============================================
// Context - Cancellation
// ============================================

pln("\n=== Context ===\n")

// Context with cancel - returns a context object
var ctx = contextWithCancel()

pln("Context done:", contextDone(ctx))

// Call the cancel method on the context
ctx.cancel()

pln("Context done after cancel:", contextDone(ctx))

pln("\n=== Concurrency demo complete ===")
