// 01b_short_var_declaration.xxl
// Short variable declaration with :=

// ============================================
// Basic short variable declaration
// ============================================

// Instead of:
// var x = 10
// You can use:
x := 10
pln("x =", x)

// Works with any type
name := "Alice"
pln("name =", name)

age := 30
pln("age =", age)

price := 19.99
pln("price =", price)

active := true
pln("active =", active)

items := [1, 2, 3, 4, 5]
pln("items =", items)

config := {"debug": true, "name": "test"}
pln("config =", config)

// ============================================
// With function calls
// ============================================

func add(a, b) {
    return a + b
}

result := add(3, 4)
pln("result =", result)

// With built-in functions
numbers := [1, 2, 3, 4, 5]
total := 0
for (n in numbers) {
    total = total + n
}
pln("total =", total)

// ============================================
// In loops
// ============================================

// Short declaration in for loop
total := 0
for (var i = 1; i <= 10; i++) {
    total = total + i
}
pln("Sum 1-10:", total)

// ============================================
// In conditions
// ============================================

data := [10, 20, 30, 40, 50]

// Calculate average
dataLen := len(data)
avg := sum(data) / dataLen
pln("Average:", avg)

// Conditional assignment
max := data[0]
for (n in data) {
    if (n > max) {
        max = n
    }
}
pln("Max:", max)

// ============================================
// Best practices
// ============================================

// Use := for new variables in local scope
// Use = for reassignment or package-level variables

// Good: initialize with :=
count := 0
name := ""

// Good: reassign with =
count = count + 1
name = "updated"

pln("count =", count)
pln("name =", name)
