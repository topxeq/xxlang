// 02_operators.xxl
// Arithmetic, comparison, logical, and assignment operators

// === Arithmetic Operators ===
var a = 10
var b = 3

pln("Arithmetic Operators:")
pln("a = ", a, ", b = ", b)
pln("a + b = ", a + b)   // Addition: 13
pln("a - b = ", a - b)   // Subtraction: 7
pln("a * b = ", a * b)   // Multiplication: 30
pln("a / b = ", a / b)   // Division: 3 (integer division)
pln("a % b = ", a % b)   // Modulo: 1

// === Floating Point ===
var x = 10.0
var y = 3.0
pln("x / y = ", x / y)   // 3.333... (float division)

// === Comparison Operators ===
pln("\nComparison Operators:")
pln("a == b: ", a == b)   // false
pln("a != b: ", a != b)   // true
pln("a < b: ", a < b)     // false
pln("a > b: ", a > b)     // true
pln("a <= b: ", a <= b)   // false
pln("a >= b: ", a >= b)   // true

// === Logical Operators ===
var t = true
var f = false

pln("\nLogical Operators:")
pln("t && f: ", t && f)   // AND: false
pln("t || f: ", t || f)   // OR: true
pln("!t: ", !t)           // NOT: false
pln("!f: ", !f)           // NOT: true

// Short-circuit evaluation
var counter = 0
func increment() {
    counter = counter + 1
    return true
}

// In &&, if left is false, right is not evaluated
var result1 = false && increment()
pln("After false && increment(), counter = ", counter)  // 0

// In ||, if left is true, right is not evaluated
var result2 = true || increment()
pln("After true || increment(), counter = ", counter)  // 0

// === Assignment Operators ===
var n = 10
pln("\nAssignment Operators:")
pln("Initial n = ", n)

n += 5
pln("n += 5: ", n)   // 15

n -= 3
pln("n -= 3: ", n)   // 12

n *= 2
pln("n *= 2: ", n)   // 24

n /= 4
pln("n /= 4: ", n)   // 6

n %= 4
pln("n %= 4: ", n)   // 2

// === Increment/Decrement ===
var i = 5
pln("\nIncrement/Decrement:")
pln("Initial i = ", i)

i++
pln("After i++: ", i)   // 6

i--
pln("After i--: ", i)   // 5

// === String Concatenation ===
var firstName = "John"
var lastName = "Doe"
var fullName = firstName + " " + lastName
pln("\nString Concatenation:")
pln("Full name: ", fullName)
