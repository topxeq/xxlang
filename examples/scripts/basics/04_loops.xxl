// 04_loops.xxl
// While loops and for loops

// === While Loop ===
pln("=== While Loop ===")
var i = 1
while (i <= 5) {
    pln("Count: ", i)
    i++
}

// === For Loop (C-style) ===
pln("\n=== For Loop (C-style) ===")
for (var j = 0; j < 5; j++) {
    pln("j = ", j)
}

// === For Loop (count down) ===
pln("\n=== For Loop (count down) ===")
for (var k = 5; k > 0; k--) {
    pln("k = ", k)
}

// === For Loop (step by 2) ===
pln("\n=== For Loop (step by 2) ===")
for (var m = 0; m <= 10; m += 2) {
    pln("m = ", m)
}

// === Sum Using Loop ===
pln("\n=== Sum Using Loop ===")
var sum = 0
for (var q = 1; q <= 10; q++) {
    sum += q
}
pln("Sum of 1 to 10 = ", sum)

// === Factorial Using While ===
pln("\n=== Factorial Using While ===")
var num = 5
var factorial = 1
var temp = num

while (temp > 1) {
    factorial = factorial * temp
    temp--
}
pln("5! = ", factorial)

// === Triangle Pattern ===
pln("\n=== Triangle Pattern ===")
for (var row = 1; row <= 5; row++) {
    var stars = ""
    for (var col = 0; col < row; col++) {
        stars = stars + "*"
    }
    pln(stars)
}

// === Array Iteration (using index) ===
pln("\n=== Array Iteration ===")
var items = ["apple", "banana", "cherry"]
pln("Items: ", items)
pln("First: ", items[0])
pln("Second: ", items[1])
pln("Third: ", items[2])

// === Nested Loops ===
pln("\n=== Nested Loops ===")
for (var row = 1; row <= 3; row++) {
    for (var col = 1; col <= 3; col++) {
        pln("Row ", row, ", Col ", col)
    }
}
