// 05_functions.xxl
// Function definitions, parameters, return values, and recursion

// === Basic Function ===
pln("=== Basic Function ===")

func greet() {
    pln("Hello, World!")
}

greet()

// === Function with Parameters ===
pln("\n=== Function with Parameters ===")

func greetPerson(name) {
    pln("Hello, ", name, "!")
}

greetPerson("Alice")
greetPerson("Bob")

// === Function with Return Value ===
pln("\n=== Function with Return Value ===")

func add(a, b) {
    return a + b
}

var result = add(3, 4)
pln("3 + 4 = ", result)

// === Multiple Return Points ===
pln("\n=== Multiple Return Points ===")

func abs(x) {
    if (x < 0) {
        return -x
    }
    return x
}

pln("abs(-5) = ", abs(-5))
pln("abs(5) = ", abs(5))

// === Early Return ===
pln("\n=== Early Return ===")

func divide(a, b) {
    if (b == 0) {
        pln("Error: Division by zero")
        return null
    }
    return a / b
}

pln("divide(10, 2) = ", divide(10, 2))
pln("divide(10, 0) = ", divide(10, 0))

// === Function Calling Function ===
pln("\n=== Function Calling Function ===")

func square(x) {
    return x * x
}

func sumOfSquares(a, b) {
    return square(a) + square(b)
}

pln("sumOfSquares(3, 4) = ", sumOfSquares(3, 4))

// === Recursion ===
pln("\n=== Recursion ===")

func factorial(n) {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}

pln("factorial(5) = ", factorial(5))
pln("factorial(10) = ", factorial(10))

// === Fibonacci (Recursive) ===
pln("\n=== Fibonacci (Recursive) ===")

func fib(n) {
    if (n <= 1) {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

pln("fib(10) = ", fib(10))
pln("fib(15) = ", fib(15))

// === Iterative Factorial ===
pln("\n=== Iterative Factorial ===")

func factorialIterative(n) {
    var result = 1
    for (var i = 2; i <= n; i++) {
        result = result * i
    }
    return result
}

pln("factorialIterative(5) = ", factorialIterative(5))
pln("factorialIterative(10) = ", factorialIterative(10))

// === Function as Value ===
pln("\n=== Function as Value ===")

var multiply = func(a, b) {
    return a * b
}

pln("multiply(4, 5) = ", multiply(4, 5))

// === Higher-Order Function ===
pln("\n=== Higher-Order Function ===")

func applyTwice(f, x) {
    return f(f(x))
}

var double = func(x) {
    return x * 2
}

pln("applyTwice(double, 3) = ", applyTwice(double, 3))

// === IIFE (Immediately Invoked Function Expression) ===
pln("\n=== IIFE ===")

var immediate = func(x) {
    return x * x
}(5)

pln("IIFE result: ", immediate)

// === Function with Default Behavior ===
pln("\n=== Function with Null Check ===")

func safeGet(map, key) {
    if (hasKey(map, key)) {
        return map[key]
    }
    return null
}

var data = {"name": "Alice", "age": 30}
pln("safeGet(data, 'name') = ", safeGet(data, "name"))
pln("safeGet(data, 'phone') = ", safeGet(data, "phone"))
