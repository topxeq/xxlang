// 03_control_flow.xxl
// If-else statements and conditional expressions

// === Basic If Statement ===
var age = 18

pln("=== Basic If Statement ===")
if (age >= 18) {
    pln("You are an adult")
}

// === If-Else Statement ===
var score = 75

pln("\n=== If-Else Statement ===")
if (score >= 60) {
    pln("Passed!")
} else {
    pln("Failed")
}

// === Nested If-Else Chain ===
// Note: Xxlang uses nested if-else for multi-way conditions
pln("\n=== Nested If-Else Chain ===")
var grade = 85

if (grade >= 90) {
    pln("Grade: A")
} else {
    if (grade >= 80) {
        pln("Grade: B")
    } else {
        if (grade >= 70) {
            pln("Grade: C")
        } else {
            if (grade >= 60) {
                pln("Grade: D")
            } else {
                pln("Grade: F")
            }
        }
    }
}

// === Nested If Statements ===
pln("\n=== Nested If Statements ===")
var isLoggedIn = true
var isAdmin = true

if (isLoggedIn) {
    if (isAdmin) {
        pln("Welcome, Admin!")
    } else {
        pln("Welcome, User!")
    }
} else {
    pln("Please log in")
}

// === Switch-like Pattern (using if-else) ===
pln("\n=== Switch-like Pattern (old way) ===")
var day = 3

// Before: Xxlang used if-else chains for switch-like behavior
if (day == 1) {
    pln("Monday")
} else {
    if (day == 2) {
        pln("Tuesday")
    } else {
        if (day == 3) {
            pln("Wednesday")
        } else {
            pln("Other day")
        }
    }
}

// === Switch Statement (preferred) ===
pln("\n=== Switch Statement ===")
// Xxlang now supports switch statements (no fall-through!)
switch (day) {
    case 1:
        pln("Monday")
    case 2:
        pln("Tuesday")
    case 3:
        pln("Wednesday")   // This executes
    case 4:
        pln("Thursday")    // NOT executed (no fall-through)
    case 5:
        pln("Friday")
    default:
        pln("Weekend")
}

// === Switch with Strings ===
pln("\n=== Switch with Strings ===")
var fruit = "apple"

switch (fruit) {
    case "apple":
        pln("Red or Green")
    case "banana":
        pln("Yellow")
    case "orange":
        pln("Orange")
    default:
        pln("Unknown fruit")
}

// === Switch with Expressions ===
pln("\n=== Switch with Expressions ===")
var x = 10
var y = 20

switch (x + y) {
    case 10:
        pln("Sum is 10")
    case 20:
        pln("Sum is 20")
    case 30:
        pln("Sum is 30")
    default:
        pln("Sum is something else")
}

// === Season Example ===
pln("\n=== Season Example ===")
var month = 2
var season = ""

if (month == 12 || month == 1 || month == 2) {
    season = "Winter"
} else {
    if (month >= 3 && month <= 5) {
        season = "Spring"
    } else {
        if (month >= 6 && month <= 8) {
            season = "Summer"
        } else {
            if (month >= 9 && month <= 11) {
                season = "Autumn"
            } else {
                season = "Unknown"
            }
        }
    }
}

pln("Month ", month, " is ", season)

// === Conditional Logic ===
pln("\n=== Conditional Logic ===")
var num = 15
var parity = ""

if (num % 2 == 0) {
    parity = "even"
} else {
    parity = "odd"
}

pln(num, " is ", parity)

// === Complex Conditions ===
pln("\n=== Complex Conditions ===")
var hasLicense = true
var hasInsurance = true
var age2 = 25

if (age2 >= 18 && hasLicense && hasInsurance) {
    pln("You can drive legally")
} else {
    pln("You cannot drive legally")
}

// === Short-Circuit Example ===
pln("\n=== Short-Circuit Evaluation ===")
var divisor = 0
var dividend = 10

// Check divisor first to prevent division by zero
if (divisor == 0) {
    pln("Cannot divide: divisor is zero")
} else {
    if (dividend / divisor > 5) {
        pln("Result is greater than 5")
    } else {
        pln("Result is too small")
    }
}
