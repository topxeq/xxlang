// 01_variables.xxl
// Basic variable declarations and types in Xxlang

// === Variable Declaration ===
// Use 'var' for mutable variables
var name = "Alice"
var age = 30
var score = 95.5
var isActive = true

pln("Name: ", name)
pln("Age: ", age)
pln("Score: ", score)
pln("Active: ", isActive)

// === Constants ===
// Use 'const' for immutable values
const PI = 3.14159
const MAX_SIZE = 100

pln("PI = ", PI)
pln("MAX_SIZE = ", MAX_SIZE)

// === Reassignment ===
// Variables declared with 'var' can be reassigned
age = 31
pln("New age: ", age)

// === Type Checking ===
// Use typeOf() to check the type of any value
pln("typeOf(name): ", typeOf(name))       // STRING
pln("typeOf(age): ", typeOf(age))         // INT
pln("typeOf(score): ", typeOf(score))     // FLOAT
pln("typeOf(isActive): ", typeOf(isActive)) // BOOL
pln("typeOf(null): ", typeOf(null))       // NULL

// === Null Value ===
var empty = null
pln("Empty value: ", empty)
pln("typeOf(empty): ", typeOf(empty))

// === Type Conversion ===
// Convert between types using built-in functions
var numStr = "42"
var numInt = int(numStr)
pln("String '42' converted to int: ", numInt)
pln("typeOf(numInt): ", typeOf(numInt))

var floatVal = 3.7
var intVal = int(floatVal)
pln("Float 3.7 converted to int: ", intVal)

var numFloat = float(numInt)
pln("Int 42 converted to float: ", numFloat)
