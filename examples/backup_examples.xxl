// ============================================================
// Xxlang Backup Module - Examples
// ============================================================

import "backup"
import "ssh"

// ============================================================
// Example 1: Local-to-Local Backup (Basic)
// ============================================================

// Simple local backup
var result = backup.localToLocal("/data/project", "/backup/project", null)
println("Copied: " + result.getFilesCopied().toStr())
println("Skipped: " + result.getFilesSkipped().toStr())
println("Duration: " + result.getDuration().toStr() + "s")

// ============================================================
// Example 2: Local-to-Local with Options
// ============================================================

var result2 = backup.localToLocal("/data/project", "/backup/project", {
    "mode": "mirror",
    "exclude": ["*.tmp", "*.log", "node_modules/*"]
})

if (result2.hasErrors()) {
    println("Errors:")
    var errors = result2.getErrors()
    for (var i = 0; i < len(errors); i = i + 1) {
        println("  " + errors[i])
    }
}

println(result2.summary())

// ============================================================
// Example 3: Using BackupTask Object
// ============================================================

var task = backup.newTask()
task.setSourceLocal("/data/project")
task.setTargetLocal("/backup/project")
task.setMode("incremental")
task.setConflictPolicy("versionBackup")
task.setExclude(["*.tmp", "*.bak"])

var result3 = task.execute()
println("Backup completed: " + result3.isSuccess().toStr())
println("Files copied: " + result3.getFilesCopied().toStr())

// ============================================================
// Example 4: Check Conflicts Before Backup
// ============================================================

var task4 = backup.newTask()
task4.setSourceLocal("/data/project")
task4.setTargetLocal("/backup/project")

var conflicts = task4.checkConflicts()
if (len(conflicts) > 0) {
    println("Found " + len(conflicts).toStr() + " conflicts:")
    for (var i = 0; i < len(conflicts); i = i + 1) {
        println("  " + conflicts[i])
    }
} else {
    println("No conflicts, safe to backup")
    var result4 = task4.execute()
    println(result4.summary())
}

// ============================================================
// Example 5: Local-to-Remote Backup (Push to Server)
// ============================================================

var client = ssh.connect("server.com", 22, "root", "password")

var result5 = backup.localToRemote(client, "/data/project", "/backup/project", {
    "mode": "incremental",
    "compareStrategy": "sizeTime"
})

println("Pushed " + result5.getFilesCopied().toStr() + " files to server")
client.close()

// ============================================================
// Example 6: Remote-to-Local Backup (Pull from Server)
// ============================================================

var client6 = ssh.connect("server.com", 22, "root", "password")

var result6 = backup.remoteToLocal(client6, "/var/log/app", "./logs/app", {
    "exclude": ["*.gz", "*.old"]
})

println("Downloaded " + result6.getBytesTransferred().toStr() + " bytes")
client6.close()

// ============================================================
// Example 7: Remote-to-Remote Backup (Server-to-Server)
// ============================================================

var srcServer = ssh.connect("server1.com", 22, "root", "password1")
var dstServer = ssh.connect("server2.com", 22, "root", "password2")

var result7 = backup.remoteToRemote(srcServer, dstServer, "/data/app", "/backup/app", {
    "mode": "mirror",
    "compareStrategy": "hash"
})

println("Server-to-server sync: " + result7.summary())

srcServer.close()
dstServer.close()

// ============================================================
// Example 8: Hash Verification for Critical Backups
// ============================================================

var task8 = backup.newTask()
task8.setSourceLocal("/data/critical")
task8.setTargetLocal("/backup/critical")
task8.setCompareStrategy("hash")  // Use MD5 hash for verification

var result8 = task8.execute()
println("Hash verification backup:")
println("  Files copied: " + result8.getFilesCopied().toStr())
println("  Files skipped: " + result8.getFilesSkipped().toStr())
println("  Bytes transferred: " + result8.getBytesTransferred().toStr())

// ============================================================
// Example 9: Mirror Mode with Delete Extra
// ============================================================

var task9 = backup.newTask()
task9.setSourceLocal("/data/web")
task9.setTargetLocal("/backup/web")
task9.setMode("mirror")  // Makes target identical to source
task9.setExclude([".git/*", "node_modules/*"])

var result9 = task9.execute()
println("Mirror sync result:")
println("  Files copied: " + result9.getFilesCopied().toStr())
println("  Files deleted: " + result9.getFilesDeleted().toStr())
println("  Summary: " + result9.summary())

// ============================================================
// Example 10: BackupResult Methods Reference
// ============================================================

// BackupResult provides these getter methods:
// - isSuccess() -> bool
// - hasErrors() -> bool
// - hasConflicts() -> bool
// - getFilesCopied() -> int
// - getFilesSkipped() -> int
// - getFilesDeleted() -> int
// - getBytesTransferred() -> int
// - getDuration() -> float (seconds)
// - getErrors() -> array of strings
// - getConflicts() -> array of strings
// - summary() -> string

var result10 = backup.localToLocal("/src", "/dst", null)

// Check status
if (result10.isSuccess()) {
    println("Backup succeeded!")
} else {
    println("Backup failed!")
}

// Get statistics
println("Statistics:")
println("  Copied: " + result10.getFilesCopied().toStr())
println("  Skipped: " + result10.getFilesSkipped().toStr())
println("  Deleted: " + result10.getFilesDeleted().toStr())
println("  Duration: " + result10.getDuration().toStr() + " seconds")
println("  Data transferred: " + result10.getBytesTransferred().toStr() + " bytes")

// Check for issues
if (result10.hasErrors()) {
    var errs = result10.getErrors()
    println("Errors (" + len(errs).toStr() + "):")
    for (var i = 0; i < len(errs); i = i + 1) {
        println("  " + errs[i])
    }
}

if (result10.hasConflicts()) {
    var confs = result10.getConflicts()
    println("Conflicts (" + len(confs).toStr() + "):")
    for (var i = 0; i < len(confs); i = i + 1) {
        println("  " + confs[i])
    }
}

// Get summary string
println("Summary: " + result10.summary())